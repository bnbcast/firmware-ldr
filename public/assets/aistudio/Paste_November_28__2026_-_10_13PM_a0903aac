        if (gCosineStepDeg < 1) gCosineStepDeg = 1;
        if (gCosineStepDeg > 15) gCosineStepDeg = 15;
        uint8_t savedMode = gPrefs.getUChar("srv_mode", static_cast<uint8_t>(ServoMode::AUTO));
        if (savedMode == static_cast<uint8_t>(ServoMode::CLOCK)) gServo.mode = ServoMode::CLOCK;
        else if (savedMode == static_cast<uint8_t>(ServoMode::HYBRID)) gServo.mode = ServoMode::HYBRID;
        else gServo.mode = ServoMode::AUTO;
        gBootCount     = gPrefs.getUInt("boot_cnt", 0) + 1;
        gBrownoutTotal = gPrefs.getUInt("bo_cnt", 0) + (gBrownoutDetected ? 1 : 0);
        bool isWdt = (gResetReason == ESP_RST_INT_WDT || gResetReason == ESP_RST_TASK_WDT || gResetReason == ESP_RST_WDT);
        bool isPan = (gResetReason == ESP_RST_PANIC);
        gWdtTotal      = gPrefs.getUInt("wdt_cnt", 0) + (isWdt ? 1 : 0);
        gPanicTotal    = gPrefs.getUInt("pan_cnt", 0) + (isPan ? 1 : 0);
        gPrefs.putUInt("boot_cnt", gBootCount);
        gPrefs.putUInt("bo_cnt", gBrownoutTotal);
        gPrefs.putUInt("wdt_cnt", gWdtTotal);
        gPrefs.putUInt("pan_cnt", gPanicTotal);
        gPrefs.end();
    }
}

