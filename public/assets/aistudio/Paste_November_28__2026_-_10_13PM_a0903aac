static void onMqttMessage(char* topic, byte* payload, unsigned int length) {
    if (strcmp(topic, gTopicCmd) != 0) return;
    char buf[128];
    size_t n = (length < sizeof(buf) - 1) ? length : (sizeof(buf) - 1);
    memcpy(buf, payload, n);
    buf[n] = '\0';
    logf(LogLevel::INFO, "MQTT", "RX cmd: %s", buf);
    handleSerialCommand(buf);
}

static void initMqttClient() {
    if (strlen(gMqttCfg.host) == 0) return;
    if (gMqttCfg.port == 1883) {
        gMqtt.setClient(gPlainClient);
    } else {
        gTlsClient.setInsecure();
        gMqtt.setClient(gTlsClient);
    }
    gMqtt.setServer(gMqttCfg.host, gMqttCfg.port);
    gMqtt.setBufferSize(1792);
    gMqtt.setKeepAlive(15);
    gMqtt.setCallback(onMqttMessage);
}

static void ensureNetworkAndMqtt() {
    if (gSetupMode) return;
    uint32_t now = millis();
    if ((now - gLastNetCheckMs) < Config::NET_RETRY_MS) return;
    gLastNetCheckMs = now;

    if (WiFi.status() != WL_CONNECTED) {
        if (gSavedWifiCount > 0) {
            logf(LogLevel::WARN, "WIFI", "WiFi terputus, mencoba sambung ulang ke '%s'...", gSavedWifis[0].ssid);
            WiFi.begin(gSavedWifis[0].ssid, gSavedWifis[0].pass);
        }
        return;
    }

    if (strlen(gMqttCfg.host) == 0) return;
    if (!gMqtt.connected()) {
        initMqttClient();
        char clientId[40];
        snprintf(clientId, sizeof(clientId), "st-%s-%04X", gMqttCfg.dev, static_cast<unsigned>(ESP.getEfuseMac() & 0xFFFF));
        bool ok = false;
        if (strlen(gMqttCfg.user) > 0) {
            ok = gMqtt.connect(clientId, gMqttCfg.user, gMqttCfg.pass, gTopicStatus, 1, true, "offline");
        } else {
            ok = gMqtt.connect(clientId, gTopicStatus, 1, true, "offline");
        }
        if (ok) {
            ++gMqttReconnCount;
            gMqtt.publish(gTopicStatus, "online", true);
            gMqtt.subscribe(gTopicCmd, 1);
            // Flush buffered boot logs once so Web UI / AI gets complete boot trace
            if (!gBootLogsFlushed) {
                gBootLogsFlushed = true;
                gPublishingLog = true;
                for (size_t i = 0; i < gBootLogCount; ++i) {
                    gMqtt.publish(gTopicLog, gBootLogs[i], false);
                }
                gPublishingLog = false;
            }
            gLastMqttRc = 0;
            logf(LogLevel::INFO, "MQTT", "Terhubung ke %s:%u (topic: solartracker/%s/*, reconn=%lu)",
                 gMqttCfg.host, gMqttCfg.port, gMqttCfg.dev, static_cast<unsigned long>(gMqttReconnCount));
        } else {
            gLastMqttRc = gMqtt.state();
            logf(LogLevel::WARN, "MQTT", "Gagal konek MQTT (rc=%d), retry 5 dtk...", gLastMqttRc);
        }
    }
}

