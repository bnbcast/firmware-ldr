static void stopSetupPortal() {
    if (!gSetupMode) return;
    gDns.stop();
    gPortalServer.stop();
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA);
    WiFi.setTxPower(WIFI_POWER_11dBm);
    WiFi.setSleep(false);
    gSetupMode = false;
    gPendingExitSetup = false;
    logf(LogLevel::INFO, "WIFI", "Mode Setup Hotspot ditutup -> beralih ke WIFI_STA + MQTT.");
}

static bool tryConnectSavedWifis() {
    if (gSavedWifiCount == 0) return false;
    WiFi.mode(WIFI_STA);
    WiFi.setTxPower(WIFI_POWER_11dBm);
    WiFi.setSleep(false);

    // Quick scan to pick strongest known SSID first
    int n = WiFi.scanNetworks(false, false, false, 200);
    int bestIdx = -1;
    int32_t bestRssi = -999;
    for (int i = 0; i < n; ++i) {
        String s = WiFi.SSID(i);
        int32_t rssi = WiFi.RSSI(i);
        for (size_t k = 0; k < gSavedWifiCount; ++k) {
            if (s == gSavedWifis[k].ssid && rssi > bestRssi) {
                bestRssi = rssi;
                bestIdx = static_cast<int>(k);
            }
        }
    }
    WiFi.scanDelete();

    // Try strongest match first, then remaining saved networks
    for (size_t pass = 0; pass < gSavedWifiCount; ++pass) {
        size_t idx = (pass == 0 && bestIdx >= 0) ? static_cast<size_t>(bestIdx) : pass;
        if (pass > 0 && bestIdx >= 0 && idx == static_cast<size_t>(bestIdx)) continue;
        logf(LogLevel::INFO, "WIFI", "Menghubungkan ke WiFi tersimpan: '%s'...", gSavedWifis[idx].ssid);
        WiFi.disconnect(true);
        delay(80);
        WiFi.begin(gSavedWifis[idx].ssid, gSavedWifis[idx].pass);
        uint32_t t0 = millis();
        while (WiFi.status() != WL_CONNECTED && (millis() - t0) < Config::WIFI_CONNECT_MS) {
            delay(100);
        }
        if (WiFi.status() == WL_CONNECTED) {
            logf(LogLevel::INFO, "WIFI", "Terhubung ke '%s' | IP=%s | RSSI=%d dBm",
                 gSavedWifis[idx].ssid, WiFi.localIP().toString().c_str(), WiFi.RSSI());
            return true;
        }
        logf(LogLevel::WARN, "WIFI", "Gagal terhubung ke '%s' (timeout).", gSavedWifis[idx].ssid);
    }
    return false;
}

static void startSetupPortal() {
    gServo.releasePwm(); // Keep SG90 idle during WiFi setup
    if (gMqtt.connected()) gMqtt.disconnect();
    WiFi.disconnect(true);
    WiFi.mode(WIFI_AP_STA);
    WiFi.setTxPower(WIFI_POWER_11dBm);
    WiFi.softAP(Config::SETUP_AP_SSID);
    IPAddress ip = WiFi.softAPIP();
    gDns.start(53, "*", ip);

    if (!gPortalRoutesInit) {
        gPortalRoutesInit = true;

        gPortalServer.on("/", HTTP_GET, []() {
            gPortalServer.send_P(200, "text/html", SETUP_HTML);
        });

        gPortalServer.on("/api/scan", HTTP_GET, []() {
            int n = WiFi.scanNetworks(false, false, false, 200);
            JsonDocument doc;
            JsonArray arr = doc["nets"].to<JsonArray>();
            for (int i = 0; i < n && i < 15; ++i) {
                JsonObject o = arr.add<JsonObject>();
                o["ssid"] = WiFi.SSID(i);
                o["rssi"] = WiFi.RSSI(i);
                o["enc"]  = (WiFi.encryptionType(i) != WIFI_AUTH_OPEN);
            }
            WiFi.scanDelete();
            String out;
            serializeJson(doc, out);
            gPortalServer.send(200, "application/json", out);
        });

        gPortalServer.on("/api/wifi/list", HTTP_GET, []() {
            JsonDocument doc;
            doc["connected"] = (WiFi.status() == WL_CONNECTED) ? WiFi.SSID() : "";
            JsonArray arr = doc["saved"].to<JsonArray>();
            for (size_t i = 0; i < gSavedWifiCount; ++i) arr.add(gSavedWifis[i].ssid);
            String out;
            serializeJson(doc, out);
            gPortalServer.send(200, "application/json", out);
        });

        gPortalServer.on("/api/wifi/add", HTTP_POST, []() {
            JsonDocument doc;
            deserializeJson(doc, gPortalServer.arg("plain"));
            const char* ssid = doc["ssid"] | "";
            const char* pass = doc["pass"] | "";
            if (strlen(ssid) == 0) {
                gPortalServer.send(400, "application/json", "{\"ok\":false,\"msg\":\"SSID kosong\"}");
                return;
            }
            addOrUpdateSavedWifi(ssid, pass);
            logf(LogLevel::INFO, "WIFI", "Saved WiFi '%s' -> mencoba konek...", ssid);
            WiFi.begin(ssid, pass);
            uint32_t t0 = millis();
            while (WiFi.status() != WL_CONNECTED && (millis() - t0) < 7000) delay(100);
            if (WiFi.status() == WL_CONNECTED) {
                logf(LogLevel::INFO, "WIFI", "Berhasil konek ke '%s' (%s)! Menutup portal...",
                     ssid, WiFi.localIP().toString().c_str());
                gPortalServer.send(200, "application/json",
                    "{\"ok\":true,\"msg\":\"Berhasil terhubung! Hotspot setup akan mati dalam 2 detik...\"}");
                gPendingExitSetup = true;
                gPendingExitMs = millis() + 2000;
            } else {
                gPortalServer.send(200, "application/json",
                    "{\"ok\":false,\"msg\":\"Disimpan ke NVS, tapi gagal konek. Cek password atau jangkauan WiFi.\"}");
            }
        });

        gPortalServer.on("/api/wifi/del", HTTP_POST, []() {
            JsonDocument doc;
            deserializeJson(doc, gPortalServer.arg("plain"));
            const char* ssid = doc["ssid"] | "";
            bool ok = deleteSavedWifi(ssid);
            gPortalServer.send(200, "application/json", ok ? "{\"ok\":true}" : "{\"ok\":false}");
        });

        gPortalServer.on("/api/exit", HTTP_POST, []() {
            gPortalServer.send(200, "application/json", "{\"ok\":true}");
            gPendingExitSetup = true;
            gPendingExitMs = millis() + 800;
        });

        // Captive portal redirect for Android/iOS/Windows probes
        gPortalServer.onNotFound([]() {
            gPortalServer.sendHeader("Location", "http://192.168.4.1/", true);
            gPortalServer.send(302, "text/plain", "");
        });
    }

    gPortalServer.begin();
    gSetupMode = true;
    logf(LogLevel::INFO, "WIFI", "=== MODE SETUP AKTIF === Konek ke WiFi '%s' lalu buka http://%s/",
         Config::SETUP_AP_SSID, ip.toString().c_str());
}

