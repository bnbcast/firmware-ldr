static float gLuxEma = 0.0f;

// Physics-based Lux (LM393 10k pull-up + GL5528 curve) & Light Source Angle/Proximity estimator
static uint32_t estimateLuxFromMv(uint16_t mv, bool brightIsHigh) {
    constexpr float VCC_MV = 3300.0f;
    float v = static_cast<float>(mv);
    if (v < 15.0f) v = 15.0f;
    if (v > 3250.0f) v = 3250.0f;
    float rLdr = brightIsHigh
        ? (10000.0f * (VCC_MV - v) / v)
        : (10000.0f * v / (VCC_MV - v));
    if (rLdr < 50.0f) rLdr = 50.0f;
    float lux = powf(500000.0f / rLdr, 1.4f);
    if (lux > 100000.0f) lux = 100000.0f;
    return static_cast<uint32_t>(lux + 0.5f);
}

// Best-practice Single-Axis Sunlight Tracker & Light-Debug Diagnostics
// Handles: (1) Night/Dark hold gate, (2) Hysteresis deadband (anti-hunting),
// (3) Distant weak light (meters away) via dark-tared raw excursion,
// (4) Blazing outdoor sunlight saturation contrast, (5) Exact debug reason.
struct SunDiag {
    bool sunDetected = false;
    bool highSensUsed = false;
    TrackingDecision decision = TrackingDecision::HOLD;
    const char* state  = "DARK";
    const char* reason = "TOO_DARK_NO_SUN";
    int exc1   = 0;
    int exc2   = 0;
    int adv    = 0;
    int thresh = 12;
    uint32_t lux1 = 0;
    uint32_t lux2 = 0;
};
static SunDiag gSunDiag;
static int8_t gLastTrackDir = 0;
static bool gPrevSunDetected = false;
static bool gPrevSatEqual = false;
static uint32_t gLastSunLogMs = 0;

static SunDiag evaluateSunTracking(bool logTransitions = false) {
    SunDiag s;
    s.lux1 = estimateLuxFromMv(gLdr1.mv, gBih1);
    s.lux2 = estimateLuxFromMv(gLdr2.mv, gBih2);

    bool wireBad = (gLdr1.health == SensorHealth::CHECK_WIRING || gLdr2.health == SensorHealth::CHECK_WIRING);
    if (wireBad) {
        s.state = "BLOCKED";
        s.reason = "WIRING_FAULT";
        gLastTrackDir = 0;
        gSunDiag = s;
        return s;
    }

    // Measure each LDR's excursion from its calibrated dark baseline (handles distant light & bright sun!)
    s.exc1 = gBih1
        ? (static_cast<int>(gLdr1.raw) - static_cast<int>(gDark1))
        : (static_cast<int>(gDark1) - static_cast<int>(gLdr1.raw));
    s.exc2 = gBih2
        ? (static_cast<int>(gLdr2.raw) - static_cast<int>(gDark2))
        : (static_cast<int>(gDark2) - static_cast<int>(gLdr2.raw));
    if (s.exc1 < 0) s.exc1 = 0;
    if (s.exc2 < 0) s.exc2 = 0;
    s.adv = s.exc1 - s.exc2;

    float maxSd = (gLdr1.sd > gLdr2.sd) ? gLdr1.sd : gLdr2.sd;
    s.thresh = static_cast<int>(maxSd * 2.5f + 0.5f);
    if (s.thresh < 10) s.thresh = 10;
    if (s.thresh > 80) s.thresh = 80; // Cap so transient servo/hand motion SD never blinds AUTO LDR tracking!

    int maxExc = (s.exc1 > s.exc2) ? s.exc1 : s.exc2;
    int maxPct = (gLdr1.pct > gLdr2.pct) ? gLdr1.pct : gLdr2.pct;
    uint32_t maxLux = (s.lux1 > s.lux2) ? s.lux1 : s.lux2;
    s.sunDetected = (maxPct >= 3) || (maxExc >= s.thresh) || (maxLux >= 20);

    // Check if both LDRs are pegged at the bright saturation rail
    bool brightSat1 = gBih1 ? (gLdr1.health == SensorHealth::SATURATED_HIGH) : (gLdr1.health == SensorHealth::SATURATED_LOW);
    bool brightSat2 = gBih2 ? (gLdr2.health == SensorHealth::SATURATED_HIGH) : (gLdr2.health == SensorHealth::SATURATED_LOW);
    bool bothBrightSat = brightSat1 && brightSat2;

    int deltaPct = gLdr1.pct - gLdr2.pct;
    int enterPct = Config::DEADBAND_PCT;      // 5% to start moving
    int exitPct  = 2;                         // 2% hysteresis to stop (prevents hunting!)
    int activePctThresh = (gLastTrackDir != 0) ? exitPct : enterPct;
    int activeRawThresh = (gLastTrackDir != 0) ? (s.thresh / 2 + 2) : s.thresh;

    if (!s.sunDetected) {
        s.decision = TrackingDecision::HOLD;
        s.state = gNightParked ? "NIGHT_PARK" : "DARK";
        s.reason = gNightParked ? "NIGHT_PARKED" : "TOO_DARK_NO_SUN";
        gLastTrackDir = 0;
    } else if (gNightParked) {
        s.decision = TrackingDecision::HOLD;
        s.state = "NIGHT_PARK";
        s.reason = "NIGHT_PARKED";
        gLastTrackDir = 0;
    } else if (deltaPct > activePctThresh) {
        s.decision = TrackingDecision::LDR1_BRIGHTER;
        gLastTrackDir = 1;
    } else if (deltaPct < -activePctThresh) {
        s.decision = TrackingDecision::LDR2_BRIGHTER;
        gLastTrackDir = -1;
    } else if (gBih1 == gBih2 && s.adv >= activeRawThresh) {
        s.decision = TrackingDecision::LDR1_BRIGHTER;
        s.highSensUsed = true;
        gLastTrackDir = 1;
    } else if (gBih1 == gBih2 && s.adv <= -activeRawThresh) {
        s.decision = TrackingDecision::LDR2_BRIGHTER;
        s.highSensUsed = true;
        gLastTrackDir = -1;
    } else {
        s.decision = TrackingDecision::HOLD;
        gLastTrackDir = 0;
    }

    if (s.decision != TrackingDecision::HOLD) {
        if (gServo.safeLock) {
            s.state = "BLOCKED";
            s.reason = "SAFE_LOCKED";
        } else if (gServo.mode == ServoMode::CLOCK) {
            s.state = "CLOCK";
            s.reason = "CLOCK_MODE";
        } else if (gServo.mode == ServoMode::HYBRID) {
            s.state = "TRACKING";
            s.reason = (s.decision == TrackingDecision::LDR1_BRIGHTER) ? "TRACKING_LDR1" : "TRACKING_LDR2";
        } else if (gServo.mode != ServoMode::AUTO) {
            s.state = "BLOCKED";
            s.reason = "MANUAL_MODE";
        } else {
            int stepDir = (s.decision == TrackingDecision::LDR1_BRIGHTER) ? 1 : -1;
            if (gServo.invert) stepDir = -stepDir;
            bool blockedByLimit = (stepDir < 0 && gServo.targetDeg <= gServo.minDeg) ||
                                  (stepDir > 0 && gServo.targetDeg >= gServo.maxDeg);
            if (blockedByLimit) {
                s.state = "AT_LIMIT";
                s.reason = "AT_LIMIT";
            } else {
                s.state = "TRACKING";
                s.reason = (s.decision == TrackingDecision::LDR1_BRIGHTER) ? "TRACKING_LDR1" : "TRACKING_LDR2";
            }
        }
    } else if (s.sunDetected) {
        if (bothBrightSat) {
            s.state = "SAT_EQUAL";
            s.reason = "BOTH_SATURATED_EQUAL";
        } else if (abs(s.adv) >= 3) {
            s.state = "ALIGNED";
            s.reason = "DIFF_BELOW_THRESH";
        } else {
            s.state = "ALIGNED";
            s.reason = "BALANCED_ON_SUN";
        }
    }

    if (logTransitions) {
        uint32_t now = millis();
        if (s.sunDetected != gPrevSunDetected && (now - gLastSunLogMs) >= 2000UL) {
            gPrevSunDetected = s.sunDetected;
            gLastSunLogMs = now;
            if (s.sunDetected) {
                logf(LogLevel::INFO, "SUN", "Cahaya terdeteksi! LDR1=%d%%(%lulux,exc=%d) LDR2=%d%%(%lulux,exc=%d) adv=%+d thr=%d",
                     gLdr1.pct, static_cast<unsigned long>(s.lux1), s.exc1,
                     gLdr2.pct, static_cast<unsigned long>(s.lux2), s.exc2, s.adv, s.thresh);
            } else {
                logf(LogLevel::INFO, "SUN", "Cahaya hilang/gelap (HOLD). raw=%u/%u exc=%d/%d",
                     gLdr1.raw, gLdr2.raw, s.exc1, s.exc2);
            }
        }
        bool satEqNow = (strcmp(s.reason, "BOTH_SATURATED_EQUAL") == 0);
        if (satEqNow && !gPrevSatEqual) {
            logf(LogLevel::WARN, "SUN", "Kedua LDR mentok cahaya sama kuat (raw=%u/%u) — tambah sekat pemisah LDR!",
                 gLdr1.raw, gLdr2.raw);
        }
        gPrevSatEqual = satEqNow;
    }

    gSunDiag = s;
    return s;
}

static TrackingDecision evaluateSmartDecision(bool* outHighSensUsed = nullptr) {
    SunDiag s = evaluateSunTracking(false);
    if (outHighSensUsed) *outHighSensUsed = s.highSensUsed;
    return s.decision;
}

static void updateNightPark(uint32_t now) {
    if (gSetupMode || gServo.safeLock) return;
    bool isEveningRtc = (gRtcPresent && gRtcPlausible && (gRtcH >= 18 || gRtcH < 5));
    uint32_t parkMs = isEveningRtc ? Config::NIGHT_PARK_EVE_MS : Config::NIGHT_PARK_DARK_MS;
    gParkThrSec = parkMs / 1000UL;

    if (gServo.mode != ServoMode::AUTO) {
        gDarkSinceMs = 0;
        gSunSinceMs = 0;
        gParkDarkSec = 0;
        return;
    }

    if (!gSunDiag.sunDetected) {
        gSunSinceMs = 0;
        if (gDarkSinceMs == 0) gDarkSinceMs = now;
        gParkDarkSec = (now - gDarkSinceMs) / 1000UL;
        if (!gNightParked && (now - gDarkSinceMs) >= parkMs) {
            gNightParked = true;
            if (gParkDeg < gServo.minDeg) gParkDeg = gServo.minDeg;
            if (gParkDeg > gServo.maxDeg) gParkDeg = gServo.maxDeg;
            gServo.setTargetDeg(gParkDeg);
            logf(LogLevel::INFO, "PARK", "Auto Night-Park aktif -> parkir ke %d deg (gelap %lu dtk%s)",
                 gParkDeg, static_cast<unsigned long>(gParkDarkSec), isEveningRtc ? ", malam RTC" : "");
        }
    } else {
        gDarkSinceMs = 0;
        gParkDarkSec = 0;
        if (gNightParked) {
            if (gSunSinceMs == 0) gSunSinceMs = now;
            if ((now - gSunSinceMs) >= Config::NIGHT_WAKE_SUN_MS) {
                gNightParked = false;
                gSunSinceMs = 0;
                logf(LogLevel::INFO, "PARK", "Cahaya matahari terdeteksi -> keluar Night-Park, lanjut AUTO TRACK!");
            }
        } else {
            gSunSinceMs = 0;
        }
    }
}

static uint16_t dayOfYear(uint16_t y, uint8_t mo, uint8_t d) {
    static const uint16_t kCumDays[12] = {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};
    if (mo < 1 || mo > 12) return 1;
    uint16_t doy = kCumDays[mo - 1] + d;
    bool leap = ((y % 4 == 0) && (y % 100 != 0)) || (y % 400 == 0);
    if (leap && mo > 2) ++doy;
    return doy;
}

// Weber-Fechner / Power-Law Log-Ratio LDR Error: ln(R2 / R1)
// Constant angular sensitivity from 200 lux (dawn) to 80,000 lux (noon), brightness cancels out!
static float computeLdrLogError() {
    constexpr float VCC_MV = 3300.0f;
    float v1 = fmaxf(15.0f, fminf(3250.0f, static_cast<float>(gLdr1.mv)));
    float v2 = fmaxf(15.0f, fminf(3250.0f, static_cast<float>(gLdr2.mv)));
    float r1 = gBih1 ? (10000.0f * (VCC_MV - v1) / v1) : (10000.0f * v1 / (VCC_MV - v1));
    float r2 = gBih2 ? (10000.0f * (VCC_MV - v2) / v2) : (10000.0f * v2 / (VCC_MV - v2));
    if (r1 < 50.0f) r1 = 50.0f;
    if (r2 < 50.0f) r2 = 50.0f;
    float logRatio = logf(r2 / r1); // >0 when LDR1 has lower R (brighter), <0 when LDR2 is brighter
    if (logRatio >  3.0f) logRatio =  3.0f;
    if (logRatio < -3.0f) logRatio = -3.0f;
    return logRatio;
}

// NOAA / Spencer True Astronomical Solar Position (Elevation, Azimuth, Equation of Time, Hour Angle)
static int computeClockTargetDeg(bool* outDay = nullptr, int* outPct = nullptr) {
    if (!gRtcPresent || !gRtcPlausible) {
        gAstroElevDeg = 0.0f; gAstroAzDeg = 90.0f; gAstroEotMin = 0.0f;
        if (outDay) *outDay = false;
        if (outPct) *outPct = 0;
        return gServo.centerDeg();
    }
    constexpr float D2R = 0.01745329252f;
    constexpr float R2D = 57.2957795131f;

    uint16_t doy = dayOfYear(gRtcY, gRtcMo, gRtcD);
    float hourF = static_cast<float>(gRtcH) + static_cast<float>(gRtcMi) / 60.0f + static_cast<float>(gRtcS) / 3600.0f;
    float gamma = (2.0f * 3.14159265f / 365.0f) * (static_cast<float>(doy - 1) + (hourF - 12.0f) / 24.0f);

    // 1. Equation of Time (minutes) & Solar Declination (radians)
    float eot = 229.18f * (0.000075f + 0.001868f * cosf(gamma) - 0.032077f * sinf(gamma)
                           - 0.014615f * cosf(2.0f * gamma) - 0.040849f * sinf(2.0f * gamma));
    float decl = 0.006918f - 0.399912f * cosf(gamma) + 0.070257f * sinf(gamma)
                 - 0.006758f * cosf(2.0f * gamma) + 0.000907f * sinf(2.0f * gamma)
                 - 0.002697f * cosf(3.0f * gamma) + 0.001480f * sinf(3.0f * gamma);
    gAstroEotMin = eot;

    // 2. True Solar Time & Hour Angle omega (-90 deg = solar sunrise, 0 = solar noon, +90 deg = sunset)
    float timeOffset = eot + 4.0f * gGeoLon - 60.0f * gGeoTz;
    float tstMin = hourF * 60.0f + timeOffset;
    while (tstMin < 0.0f) tstMin += 1440.0f;
    while (tstMin >= 1440.0f) tstMin -= 1440.0f;
    float haDeg = (tstMin / 4.0f) - 180.0f;
    float haRad = haDeg * D2R;
    float latRad = gGeoLat * D2R;

    // 3. True Solar Elevation & Azimuth
    float sinEl = sinf(latRad) * sinf(decl) + cosf(latRad) * cosf(decl) * cosf(haRad);
    if (sinEl >  1.0f) sinEl =  1.0f;
    if (sinEl < -1.0f) sinEl = -1.0f;
    float elRad = asinf(sinEl);
    gAstroElevDeg = elRad * R2D;

    float cosAzDen = cosf(latRad) * cosf(elRad);
    float cosAz = (fabsf(cosAzDen) > 1e-4f) ? ((sinf(decl) - sinf(latRad) * sinEl) / cosAzDen) : 0.0f;
    if (cosAz >  1.0f) cosAz =  1.0f;
    if (cosAz < -1.0f) cosAz = -1.0f;
    float azDeg = acosf(cosAz) * R2D;
    if (haDeg > 0.0f) azDeg = 360.0f - azDeg; // Afternoon -> West (180..360)
    gAstroAzDeg = azDeg;

    // 4. Daylight window check: respect custom schedule [gClockStartMin..gClockEndMin] AND horizon
    uint32_t nowMin = static_cast<uint32_t>(gRtcH) * 60UL + gRtcMi;
    bool inWindow = (nowMin >= gClockStartMin && nowMin < gClockEndMin);
    bool customSched = (gClockStartMin != 360 || gClockEndMin != 1080);
    bool isDay = customSched ? inWindow : (inWindow && gAstroElevDeg > 1.5f);

    if (!isDay) {
        if (outDay) *outDay = false;
        if (outPct) *outPct = (haDeg < 0.0f) ? 0 : 100;
        int p = gParkDeg;
        if (p < gServo.minDeg) p = gServo.minDeg;
        if (p > gServo.maxDeg) p = gServo.maxDeg;
        return p;
    }

    // 5. True Solar Hour-Angle projection (includes Equation of Time & site longitude!)
    float frac;
    if (customSched) {
        float nowSec = hourF * 3600.0f;
        float sSec = static_cast<float>(gClockStartMin) * 60.0f;
        float eSec = static_cast<float>(gClockEndMin) * 60.0f;
        frac = (eSec > sSec + 60.0f) ? ((nowSec - sSec) / (eSec - sSec)) : 0.5f;
    } else {
        // Astronomical sunrise-to-sunset hour angle (-90 deg -> +90 deg)
        frac = (haDeg + 90.0f) / 180.0f;
    }
    if (frac < 0.0f) frac = 0.0f;
    if (frac > 1.0f) frac = 1.0f;
    if (outDay) *outDay = true;
    if (outPct) *outPct = static_cast<int>(frac * 100.0f + 0.5f);

    float span = static_cast<float>(gServo.maxDeg - gServo.minDeg);
    float fDeg = gServo.invert
        ? (static_cast<float>(gServo.maxDeg) - frac * span)
        : (static_cast<float>(gServo.minDeg) + frac * span);
    int deg = static_cast<int>(fDeg + 0.5f);
    if (deg < gServo.minDeg) deg = gServo.minDeg;
    if (deg > gServo.maxDeg) deg = gServo.maxDeg;
    return deg;
}

static void updateClockAndHybrid(uint32_t now) {
    bool prevDay = gClockDay;
    gClockDeg = computeClockTargetDeg(&gClockDay, &gClockPct);

    // Always update live Physics diagnostics (Weber-Fechner log-ratio, Lambert cosine efficiency, fusion weight)
    gLdrLogErr = computeLdrLogError();
    float errDeg = fabsf(static_cast<float>(gServo.currentDeg - gClockDeg));
    float cosVal = cosf(errDeg * 0.01745329252f);
    gAstroCosEffPct = (cosVal > 0.0f) ? (cosVal * 100.0f) : 0.0f;

    uint32_t maxLux = (gSunDiag.lux1 > gSunDiag.lux2) ? gSunDiag.lux1 : gSunDiag.lux2;
    float maxSd = (gLdr1.sd > gLdr2.sd) ? gLdr1.sd : gLdr2.sd;
    float luxConf = (maxLux <= 20UL) ? 0.0f : fminf(1.0f, static_cast<float>(maxLux - 20UL) / 380.0f);
    float stabConf = 1.0f / (1.0f + (maxSd / 30.0f));
    gFusionWeight = (gClockDay && gSunDiag.sunDetected) ? (luxConf * stabConf) : 0.0f;

    if (gSetupMode || gServo.safeLock) return;
    if (gServo.mode != ServoMode::CLOCK && gServo.mode != ServoMode::HYBRID) return;

    if (!gRtcPresent || !gRtcPlausible) {
        if (!gClockRtcWarned) {
            gClockRtcWarned = true;
            logf(LogLevel::WARN, "CLK", "Mode %s butuh RTC valid! Klik 'Sinkron RTC WIB' dulu.", servoModeToString(gServo.mode));
        }
        return;
    }
    gClockRtcWarned = false;

    if (gServo.mode == ServoMode::CLOCK) {
        gHybridBiasF = 0.0f;
        gHybridBiasDeg = 0;
        gNightParked = !gClockDay;
        // Lambert Cosine-Law energy-optimal deadband: only wake servo when error >= gCosineStepDeg (or day/night change / force sync)
        bool dayChanged = (gClockDay != prevDay);
        int deltaTarget = abs(gClockDeg - gServo.targetDeg);
        if (gClockForceSync || dayChanged || deltaTarget >= gCosineStepDeg) {
            gClockForceSync = false;
            if (gServo.targetDeg != gClockDeg) {
                gServo.setTargetDeg(gClockDeg);
            }
        }
        return;
    }

    // HYBRID mode: Complementary Confidence-Weighted Fusion + PD Damped Log-Ratio Control
    if (!gClockDay) {
        gHybridBiasF = 0.0f;
        gHybridBiasDeg = 0;
        gNightParked = true;
        if (gServo.targetDeg != gClockDeg) gServo.setTargetDeg(gClockDeg);
        return;
    }

    gNightParked = false;
    float dt = (gLastPdMs > 0 && now > gLastPdMs) ? (static_cast<float>(now - gLastPdMs) / 1000.0f) : 0.25f;
    if (dt < 0.05f) dt = 0.05f;
    if (dt > 2.0f) dt = 2.0f;
    gLastPdMs = now;

    // Derivative damping term (filtered de/dt prevents overshoot & hunting!)
    float rawDeriv = (gLdrLogErr - gPrevLogErr) / dt;
    gLogErrDerivEma = (gLogErrDerivEma * 0.7f) + (rawDeriv * 0.3f);
    gPrevLogErr = gLdrLogErr;

    bool ldrOk = (gLdr1.health != SensorHealth::CHECK_WIRING) && (gLdr2.health != SensorHealth::CHECK_WIRING);
    if (ldrOk && gFusionWeight >= 0.15f && gHybridMaxBias > 0) {
        // PD controller on Weber-Fechner log-ratio error (deadband |e| < 0.12 -> ~12% brightness ratio)
        float eNorm = (fabsf(gLdrLogErr) > 0.12f) ? (gLdrLogErr / 2.0f) : 0.0f;
        if (eNorm != 0.0f) {
            constexpr float KP = 3.2f;
            constexpr float KD = 0.65f;
            float u = (KP * eNorm) - (KD * (gLogErrDerivEma / 2.0f));
            if (gServo.invert) u = -u;
            if (u >  3.0f) u =  3.0f;
            if (u < -3.0f) u = -3.0f;
            gHybridBiasF += u * dt * 2.0f;
            float maxB = static_cast<float>(gHybridMaxBias);
            if (gHybridBiasF >  maxB) gHybridBiasF =  maxB;
            if (gHybridBiasF < -maxB) gHybridBiasF = -maxB;
            gLastClockDecayMs = now;
        }
    } else if (fabsf(gHybridBiasF) > 0.2f && (now - gLastClockDecayMs) >= 2000UL) {
        // Cloudy / shaded / flickering: confidence w dropped -> smoothly relax bias back to 0 (pure astro angle)
        gLastClockDecayMs = now;
        gHybridBiasF *= 0.80f;
        if (fabsf(gHybridBiasF) < 0.3f) gHybridBiasF = 0.0f;
    }

    // Confidence-weighted fusion: target = astro + w * bias
    gHybridBiasDeg = static_cast<int>(roundf(gFusionWeight * gHybridBiasF));
    int target = gClockDeg + gHybridBiasDeg;
    if (target < gServo.minDeg) target = gServo.minDeg;
    if (target > gServo.maxDeg) target = gServo.maxDeg;

    int deltaTarget = abs(target - gServo.targetDeg);
    if (gClockForceSync || deltaTarget >= 2) {
        gClockForceSync = false;
        if (gServo.targetDeg != target) gServo.setTargetDeg(target);
    }
}

static void publishStructuredTelemetry() {
    TrackingDecision dec = evaluateSmartDecision();
    int delta = gLdr1.pct - gLdr2.pct;
    char rtcStr[24];
    formatRtcStr(rtcStr, sizeof(rtcStr));

    JsonDocument doc;
    doc["up"]       = millis();
    doc["fw"]       = Config::FIRMWARE_VERSION;
    doc["rst"]      = resetReasonToString(gResetReason);
    doc["boot"]     = gBootCount;
    doc["bo"]       = gBrownoutTotal;
    doc["wdt"]      = gWdtTotal;
    doc["panic"]    = gPanicTotal;
    doc["heap"]     = ESP.getFreeHeap();
    doc["minHeap"]  = ESP.getMinFreeHeap();
    doc["maxAlloc"] = ESP.getMaxAllocHeap();
    doc["tempC"]    = static_cast<int>(temperatureRead() * 10.0f) / 10.0f;
    doc["loopMs"]   = gLoopMaxMs;
    doc["i2cErr"]   = gRtcFails;
    doc["eeprom"]   = gEepromPresent;
    doc["lastCmd"]  = gLastCmd;
    gLoopMaxMs = 0;

    JsonObject jp = doc["pwr"].to<JsonObject>();
    jp["baseMv"] = gRailBaseMv;
    jp["minMv"]  = gMinRailMv;
    jp["sagMv"]  = gLastSagMv;
    jp["emiSd"]  = gEmiDeltaSd;

    JsonObject j1 = doc["l1"].to<JsonObject>();
    j1["raw"] = gLdr1.raw; j1["mv"] = gLdr1.mv; j1["pct"] = gLdr1.pct;
    j1["min"] = gLdr1.minRaw; j1["max"] = gLdr1.maxRaw;
    j1["sd"]  = static_cast<int>(gLdr1.sd + 0.5f);
    j1["h"]   = healthToString(gLdr1.health);
    j1["bih"] = gBih1;

    JsonObject j2 = doc["l2"].to<JsonObject>();
    j2["raw"] = gLdr2.raw; j2["mv"] = gLdr2.mv; j2["pct"] = gLdr2.pct;
    j2["min"] = gLdr2.minRaw; j2["max"] = gLdr2.maxRaw;
    j2["sd"]  = static_cast<int>(gLdr2.sd + 0.5f);
    j2["h"]   = healthToString(gLdr2.health);
    j2["bih"] = gBih2;

    JsonObject jc = doc["cal"].to<JsonObject>();
    jc["d1"] = gDark1; jc["b1"] = gBright1;
    jc["d2"] = gDark2; jc["b2"] = gBright2;
    jc["ok"] = gCalibrated;

    doc["dec"]   = decisionToString(dec);
    doc["delta"] = delta;

    // Physics-based Light Source Vector (Normalized Lux Ratio Angle + Ambient-Subtracted EMA Lux + Inverse-Square Distance)
    uint32_t lux1 = estimateLuxFromMv(gLdr1.mv, gBih1);
    uint32_t lux2 = estimateLuxFromMv(gLdr2.mv, gBih2);
    uint32_t rawPeakLux = (lux1 > lux2) ? lux1 : lux2;
    if (gLuxEma <= 0.1f) gLuxEma = static_cast<float>(rawPeakLux);
    else gLuxEma = (gLuxEma * 0.65f) + (static_cast<float>(rawPeakLux) * 0.35f);
    uint32_t smoothLux = static_cast<uint32_t>(gLuxEma + 0.5f);

    // Subtract ambient dark floor (~4 lux) for cleaner inverse-square distance
    float netLux = (gLuxEma > 4.0f) ? (gLuxEma - 4.0f) : 0.0f;
    int maxPct = (gLdr1.pct > gLdr2.pct) ? gLdr1.pct : gLdr2.pct;
    int dirSign = gServo.invert ? -1 : 1;
    // Normalized lux contrast ratio (-1.0..+1.0) works consistently across dim indoor AND bright outdoor light
    float luxSum = static_cast<float>(lux1 + lux2);
    float luxRatio = (luxSum > 10.0f) ? (static_cast<float>(static_cast<int32_t>(lux1) - static_cast<int32_t>(lux2)) / luxSum) : 0.0f;
    int estDeg = gServo.currentDeg + static_cast<int>(dirSign * (luxRatio * 45.0f));
    if (estDeg < 0) estDeg = 0;
    if (estDeg > 180) estDeg = 180;
    uint16_t estCm = (netLux >= 12.0f) ? static_cast<uint16_t>(fminf(500.0f, 520.0f / sqrtf(netLux))) : 0;
    JsonObject jl = doc["light"].to<JsonObject>();
    jl["lux"] = smoothLux;
    jl["deg"] = (maxPct > 1) ? estDeg : -1;
    jl["cm"]  = (maxPct > 1) ? estCm : 0;

    JsonObject jr = doc["rtc"].to<JsonObject>();
    jr["t"] = rtcStr; jr["p"] = gRtcPresent; jr["r"] = gRtcRunning; jr["ok"] = gRtcPlausible;

    JsonObject js = doc["srv"].to<JsonObject>();
    js["mode"]   = servoModeToString(gServo.mode);
    js["deg"]    = gServo.currentDeg;
    js["target"] = gServo.targetDeg;
    js["trim"]   = gServo.trimDeg;
    js["min"]    = gServo.minDeg;
    js["max"]    = gServo.maxDeg;
    js["ctr"]    = gServo.centerDeg();
    js["phys"]   = gServo.physicalDeg();
    js["us"]     = gServo.lastPulseUs;
    js["pwmS"]   = gServo.pwmOnMs / 1000UL;
    js["moves"]  = gServo.moveCount;
    js["dirChg"] = gServo.dirChgInMin;
    js["inv"]    = gServo.invert;
    js["mov"]    = gServo.isMoving();
    js["pwm"]    = gServo.pwmActive;
    js["lim"]    = gServo.atLimit;
    js["lock"]   = gServo.safeLock;
    js["soft"]   = gServo.inSoftStart();

    JsonObject jsun = doc["sun"].to<JsonObject>();
    jsun["ok"]  = gSunDiag.sunDetected;
    jsun["st"]  = gSunDiag.state;
    jsun["rsn"] = gSunDiag.reason;
    jsun["e1"]  = gSunDiag.exc1;
    jsun["e2"]  = gSunDiag.exc2;
    jsun["adv"] = gSunDiag.adv;
    jsun["thr"] = gSunDiag.thresh;
    jsun["lx1"] = gSunDiag.lux1;
    jsun["lx2"] = gSunDiag.lux2;

    JsonObject jpk = doc["park"].to<JsonObject>();
    jpk["on"]    = gNightParked;
    jpk["deg"]   = gParkDeg;
    jpk["darkS"] = gParkDarkSec;
    jpk["thrS"]  = gParkThrSec;

    JsonObject jclk = doc["clk"].to<JsonObject>();
    jclk["deg"]  = gClockDeg;
    jclk["day"]  = gClockDay;
    jclk["pct"]  = gClockPct;
    jclk["sMin"] = gClockStartMin;
    jclk["eMin"] = gClockEndMin;
    jclk["bias"] = gHybridBiasDeg;
    jclk["maxB"] = gHybridMaxBias;

    JsonObject jas = doc["astro"].to<JsonObject>();
    jas["el"]   = static_cast<int>(roundf(gAstroElevDeg * 10.0f)) / 10.0f;
    jas["az"]   = static_cast<int>(roundf(gAstroAzDeg));
    jas["eot"]  = static_cast<int>(roundf(gAstroEotMin * 10.0f)) / 10.0f;
    jas["eff"]  = static_cast<int>(roundf(gAstroCosEffPct * 10.0f)) / 10.0f;
    jas["w"]    = static_cast<int>(roundf(gFusionWeight * 100.0f)) / 100.0f;
    jas["logE"] = static_cast<int>(roundf(gLdrLogErr * 100.0f)) / 100.0f;
    jas["lat"]  = static_cast<int>(roundf(gGeoLat * 100.0f)) / 100.0f;
    jas["lon"]  = static_cast<int>(roundf(gGeoLon * 100.0f)) / 100.0f;
    jas["tz"]   = static_cast<int>(roundf(gGeoTz * 10.0f)) / 10.0f;
    jas["step"] = gCosineStepDeg;

    JsonObject jw = doc["wifi"].to<JsonObject>();
    jw["ok"]    = (WiFi.status() == WL_CONNECTED);
    jw["ssid"]  = (WiFi.status() == WL_CONNECTED) ? WiFi.SSID() : "";
    jw["ip"]    = (WiFi.status() == WL_CONNECTED) ? WiFi.localIP().toString() : "";
    jw["rssi"]  = (WiFi.status() == WL_CONNECTED) ? WiFi.RSSI() : 0;
    jw["ch"]    = (WiFi.status() == WL_CONNECTED) ? WiFi.channel() : 0;
    jw["disc"]  = gWifiDiscCount;
    jw["setup"] = gSetupMode;

    JsonObject jm = doc["mqtt"].to<JsonObject>();
    jm["ok"]     = gMqtt.connected();
    jm["reconn"] = gMqttReconnCount;
    jm["fail"]   = gMqttFailCount;
    jm["rc"]     = gLastMqttRc;
    jm["dev"]    = gMqttCfg.dev;

    JsonObject jst = doc["stats"].to<JsonObject>();
    jst["holdS"]  = gHoldSec;
    jst["trackS"] = gTrackSec;
    jst["satS"]   = gSatSec;

    JsonArray faults = doc["faults"].to<JsonArray>();
    if (gBrownoutDetected) faults.add("BROWNOUT_RESET");
    if (gServo.safeLock) faults.add("SERVO_BROWNOUT_LOCK");
    if (gLastSagMv >= 40) faults.add("RAIL_3V3_SAG");
    if (gEmiDeltaSd >= 35) faults.add("SERVO_EMI_NOISE");
    if (gLdr1.health == SensorHealth::CHECK_WIRING) faults.add("LDR1_CHECK_WIRING");
    if (gLdr2.health == SensorHealth::CHECK_WIRING) faults.add("LDR2_CHECK_WIRING");
    if (gLdr1Frozen) faults.add("LDR1_FROZEN");
    if (gLdr2Frozen) faults.add("LDR2_FROZEN");
    if ((gLdr1.health == SensorHealth::SATURATED_HIGH && gLdr2.health == SensorHealth::SATURATED_HIGH) ||
        (gLdr1.health == SensorHealth::SATURATED_LOW  && gLdr2.health == SensorHealth::SATURATED_LOW)) {
        faults.add("BOTH_SATURATED");
    }
    if (!gCalibrated) faults.add("UNCALIBRATED");
    if (gServo.atLimit) faults.add("SERVO_AT_LIMIT");
    if (gServo.wrongDirSuspected) faults.add("WRONG_DIRECTION_SUSPECTED");
    if (gServo.noResponseSuspected) faults.add("SERVO_NO_RESPONSE");
    if (gServo.huntingSuspected) faults.add("SERVO_HUNTING");
    if (!gRtcPresent || !gRtcRunning || !gRtcPlausible) faults.add("RTC_INVALID");
    if (ESP.getMaxAllocHeap() < 36000) faults.add("LOW_HEAP_CONTIG");

    char payload[1536];
    size_t len = serializeJson(doc, payload, sizeof(payload));
    Serial.print("[TELEM] ");
    Serial.println(payload);

    if (!gSetupMode && gMqtt.connected() && len > 0) {
        if (!gMqtt.publish(gTopicTelem, payload, true)) {
            ++gMqttFailCount;
            gLastMqttRc = gMqtt.state();
        }
    }

    // Push history snapshot to Cloudflare D1 safely on Core 1 ONLY when servo is idle & heap has >=48KB contiguous
    if (!gSetupMode && !gServo.isMoving() &&
        WiFi.status() == WL_CONNECTED &&
        ESP.getMaxAllocHeap() >= 48000 &&
        strlen(CF_INGEST_URL) > 0 && strlen(CF_INGEST_KEY) > 0 && len > 0) {
        uint32_t nowMs = millis();
        bool backoffDone = (gCfBackoffMs == 0 || (nowMs - gLastCfPushMs) >= gCfBackoffMs);
        bool isSpike = (gCfLastP1 >= 0) &&
                       (abs(gLdr1.pct - gCfLastP1) >= Config::CF_SPIKE_DELTA_PCT ||
                        abs(gLdr2.pct - gCfLastP2) >= Config::CF_SPIKE_DELTA_PCT);
        bool dueRoutine = (gLastCfPushMs == 0 || (nowMs - gLastCfPushMs) >= Config::CF_INGEST_MS);
        bool dueSpike   = isSpike && ((nowMs - gLastCfPushMs) >= Config::CF_SPIKE_MIN_MS);
        if (backoffDone && (dueRoutine || dueSpike)) {
            gLastCfPushMs = nowMs;
            gCfLastP1 = gLdr1.pct;
            gCfLastP2 = gLdr2.pct;
            WiFiClientSecure cfClient;
            cfClient.setInsecure();
            cfClient.setHandshakeTimeout(6);
            HTTPClient http;
            http.setReuse(false);
            http.setConnectTimeout(4000);
            http.setTimeout(5000);
            if (http.begin(cfClient, CF_INGEST_URL)) {
                http.addHeader("Content-Type", "application/json");
                http.addHeader("X-Ingest-Key", CF_INGEST_KEY);
                int code = http.POST(reinterpret_cast<uint8_t*>(payload), len);
                http.end();
                if (code >= 200 && code < 300) {
                    ++gCfPushOk;
                    gCfBackoffMs = 0;
                    if (gCfPushOk == 1) logf(LogLevel::INFO, "HIST", "Cloudflare D1 history sync aktif (HTTP %d)", code);
                } else {
                    ++gCfPushFail;
                    gCfBackoffMs = 30000UL; // 30s backoff on failure so TLS heap doesn't thrash
                    logf(LogLevel::WARN, "HIST", "Cloudflare D1 ingest gagal (HTTP %d, fail=%lu, retry 30d)",
                         code, static_cast<unsigned long>(gCfPushFail));
                }
            }
        }
    }
}

