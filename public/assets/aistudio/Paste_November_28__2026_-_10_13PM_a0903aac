static uint16_t medianFilteredAvg(const uint16_t* samples, size_t n) {
    if (!samples || n == 0) return 0;
    uint16_t s[32];
    if (n > 32) n = 32;
    memcpy(s, samples, n * sizeof(uint16_t));
    for (size_t i = 1; i < n; ++i) {
        uint16_t key = s[i];
        size_t j = i;
        while (j > 0 && s[j - 1] > key) { s[j] = s[j - 1]; --j; }
        s[j] = key;
    }
    size_t start = (n >= 4) ? (n / 4) : 0;
    size_t end   = (n >= 4) ? (n - n / 4) : n;
    uint32_t sum = 0;
    for (size_t i = start; i < end; ++i) sum += s[i];
    size_t kept = end - start;
    return static_cast<uint16_t>((sum + kept / 2) / kept);
}

static int normalizePercent(uint16_t raw, uint16_t dark, uint16_t bright, bool brightIsHigh) {
    int32_t low  = brightIsHigh ? dark : bright;
    int32_t high = brightIsHigh ? bright : dark;
    if (high <= low) { low = 0; high = 4095; }
    int32_t pct = brightIsHigh
        ? ((static_cast<int32_t>(raw) - low) * 100) / (high - low)
        : ((high - static_cast<int32_t>(raw)) * 100) / (high - low);
    if (pct < 0) pct = 0;
    if (pct > 100) pct = 100;
    return static_cast<int>(pct);
}

static TrackingDecision evaluateDelta(int p1, int p2) {
    int d = p1 - p2;
    if (d > Config::DEADBAND_PCT)  return TrackingDecision::LDR1_BRIGHTER;
    if (d < -Config::DEADBAND_PCT) return TrackingDecision::LDR2_BRIGHTER;
    return TrackingDecision::HOLD;
}

static bool isDatePlausible(uint16_t y, uint8_t m, uint8_t d, uint8_t hh, uint8_t mm, uint8_t ss) {
    if (y < Config::RTC_MIN_YEAR || y > Config::RTC_MAX_YEAR) return false;
    if (m < 1 || m > 12 || d < 1 || d > 31 || hh > 23 || mm > 59 || ss > 59) return false;
    return true;
}

