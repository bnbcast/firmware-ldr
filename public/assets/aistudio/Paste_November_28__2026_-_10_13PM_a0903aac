struct LdrChannel {
    uint8_t pin;
    const char* name;
    uint16_t win[Config::WINDOW_SIZE];
    size_t winHead = 0, winCount = 0;
    uint16_t stuckZeroCycles = 0;
    uint16_t raw = 0, mv = 0, minRaw = 0, maxRaw = 0;
    float emaRaw = -1.0f;
    float sd = 0.0f;
    int pct = 0;
    bool lowRangeAttn = false; // Auto-ranging: ADC_2_5db (<850 mV direct sun) vs ADC_11db (>1050 mV)
    SensorHealth health = SensorHealth::OK;
    uint16_t lastSamples[Config::ADC_SAMPLES];

    void begin() {
        analogReadResolution(Config::ADC_BITS);
        analogSetAttenuation(ADC_11db);
        (void)analogRead(pin);
        analogSetPinAttenuation(pin, ADC_11db);
        lowRangeAttn = false;
    }

    void resetStats() { winHead = 0; winCount = 0; stuckZeroCycles = 0; emaRaw = -1.0f; }

    void sample(uint16_t dark, uint16_t bright, bool bih) {
        uint32_t mvSum = 0;
        for (uint8_t i = 0; i < Config::ADC_SAMPLES; ++i) {
            uint16_t m = static_cast<uint16_t>(analogReadMilliVolts(pin));
            mvSum += m;
            if (lowRangeAttn) {
                // Map calibrated mV onto unified 0..4095 (3145 mV) scale so calibration & charts stay seamless
                uint32_t eq = (static_cast<uint32_t>(m) * 4095UL) / 3145UL;
                lastSamples[i] = static_cast<uint16_t>(eq > 4095UL ? 4095UL : eq);
            } else {
                lastSamples[i] = static_cast<uint16_t>(analogRead(pin));
            }
        }
        uint16_t medRaw = medianFilteredAvg(lastSamples, Config::ADC_SAMPLES);
        if (emaRaw < 0.0f) emaRaw = static_cast<float>(medRaw);
        else emaRaw = (emaRaw * 0.65f) + (static_cast<float>(medRaw) * 0.35f);
        raw = static_cast<uint16_t>(emaRaw + 0.5f);
        mv  = static_cast<uint16_t>(mvSum / Config::ADC_SAMPLES);

        // Auto-ranging ESP32 ADC attenuation for 3x finer resolution in bright outdoor sunlight
        if (!lowRangeAttn && mv < 850 && mv > 0) {
            analogSetPinAttenuation(pin, ADC_2_5db);
            lowRangeAttn = true;
        } else if (lowRangeAttn && mv > 1050) {
            analogSetPinAttenuation(pin, ADC_11db);
            lowRangeAttn = false;
        }

        win[winHead] = raw;
        winHead = (winHead + 1) % Config::WINDOW_SIZE;
        if (winCount < Config::WINDOW_SIZE) ++winCount;

        minRaw = win[0]; maxRaw = win[0];
        uint32_t sum = 0;
        for (size_t i = 0; i < winCount; ++i) {
            if (win[i] < minRaw) minRaw = win[i];
            if (win[i] > maxRaw) maxRaw = win[i];
            sum += win[i];
        }
        float mean = static_cast<float>(sum) / static_cast<float>(winCount);
        float var = 0.0f;
        for (size_t i = 0; i < winCount; ++i) {
            float diff = static_cast<float>(win[i]) - mean;
            var += diff * diff;
        }
        sd = (winCount >= 2) ? sqrtf(var / static_cast<float>(winCount)) : 0.0f;

        // Only treat stuck-at-0 mV as CHECK_WIRING when brightIsHigh==true.
        // For standard 4-pin LM393 AO (bih==false), blazing sunlight pulls AO toward 0 mV -> SATURATED_LOW, NOT wiring fault!
        if (bih && raw == 0 && mv == 0) {
            if (stuckZeroCycles < 65535) ++stuckZeroCycles;
        } else {
            stuckZeroCycles = 0;
        }

        if (stuckZeroCycles >= Config::STUCK_ZERO_CYCLES || sd > Config::FLOATING_SD_RAW) {
            health = SensorHealth::CHECK_WIRING;
        } else if (raw <= Config::SAT_LOW_RAW || mv < Config::SAT_LOW_MV) {
            health = SensorHealth::SATURATED_LOW;
        } else if (raw >= Config::SAT_HIGH_RAW || mv > Config::SAT_HIGH_MV) {
            health = SensorHealth::SATURATED_HIGH;
        } else {
            health = SensorHealth::OK;
        }
        pct = normalizePercent(raw, dark, bright, bih);
    }
};

