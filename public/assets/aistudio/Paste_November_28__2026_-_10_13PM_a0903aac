static void saveNetConfig() {
    if (gPrefs.begin(Config::NVS_NET_NS, false)) {
        gPrefs.putUInt("w_cnt", static_cast<uint32_t>(gSavedWifiCount));
        for (size_t i = 0; i < Config::MAX_SAVED_WIFI; ++i) {
            char ks[8], kp[8];
            snprintf(ks, sizeof(ks), "w_s%u", static_cast<unsigned>(i));
            snprintf(kp, sizeof(kp), "w_p%u", static_cast<unsigned>(i));
            if (i < gSavedWifiCount) {
                gPrefs.putString(ks, gSavedWifis[i].ssid);
                gPrefs.putString(kp, gSavedWifis[i].pass);
            } else {
                gPrefs.remove(ks);
                gPrefs.remove(kp);
            }
        }
        gPrefs.putString("m_host", gMqttCfg.host);
        gPrefs.putUShort("m_port", gMqttCfg.port);
        gPrefs.putString("m_user", gMqttCfg.user);
        gPrefs.putString("m_pass", gMqttCfg.pass);
        gPrefs.putString("m_dev", gMqttCfg.dev);
        gPrefs.end();
    }
}

static bool addOrUpdateSavedWifi(const char* ssid, const char* pass) {
    if (!ssid || strlen(ssid) == 0) return false;
    // Update existing and move to index 0 (highest priority)
    for (size_t i = 0; i < gSavedWifiCount; ++i) {
        if (strcmp(gSavedWifis[i].ssid, ssid) == 0) {
            SavedWifi tmp;
            strncpy(tmp.ssid, ssid, sizeof(tmp.ssid) - 1); tmp.ssid[sizeof(tmp.ssid) - 1] = '\0';
            strncpy(tmp.pass, pass ? pass : "", sizeof(tmp.pass) - 1); tmp.pass[sizeof(tmp.pass) - 1] = '\0';
            for (size_t j = i; j > 0; --j) gSavedWifis[j] = gSavedWifis[j - 1];
            gSavedWifis[0] = tmp;
            saveNetConfig();
            return true;
        }
    }
    // Insert new at index 0
    if (gSavedWifiCount < Config::MAX_SAVED_WIFI) ++gSavedWifiCount;
    for (size_t j = gSavedWifiCount - 1; j > 0; --j) gSavedWifis[j] = gSavedWifis[j - 1];
    strncpy(gSavedWifis[0].ssid, ssid, sizeof(gSavedWifis[0].ssid) - 1);
    gSavedWifis[0].ssid[sizeof(gSavedWifis[0].ssid) - 1] = '\0';
    strncpy(gSavedWifis[0].pass, pass ? pass : "", sizeof(gSavedWifis[0].pass) - 1);
    gSavedWifis[0].pass[sizeof(gSavedWifis[0].pass) - 1] = '\0';
    saveNetConfig();
    return true;
}

static bool deleteSavedWifi(const char* ssid) {
    if (!ssid || strlen(ssid) == 0) return false;
    for (size_t i = 0; i < gSavedWifiCount; ++i) {
        if (strcmp(gSavedWifis[i].ssid, ssid) == 0) {
            for (size_t j = i; j + 1 < gSavedWifiCount; ++j) gSavedWifis[j] = gSavedWifis[j + 1];
            --gSavedWifiCount;
            saveNetConfig();
            return true;
        }
    }
    return false;
}

static void buildMqttTopics() {
    const char* dev = (strlen(gMqttCfg.dev) > 0) ? gMqttCfg.dev : "rig1";
    snprintf(gTopicStatus, sizeof(gTopicStatus), "solartracker/%s/status", dev);
    snprintf(gTopicTelem,  sizeof(gTopicTelem),  "solartracker/%s/telem",  dev);
    snprintf(gTopicLog,    sizeof(gTopicLog),    "solartracker/%s/log",    dev);
    snprintf(gTopicCmd,    sizeof(gTopicCmd),    "solartracker/%s/cmd",    dev);
}

static void loadNetConfig() {
    gSavedWifiCount = 0;
    if (gPrefs.begin(Config::NVS_NET_NS, true)) {
        uint32_t cnt = gPrefs.getUInt("w_cnt", 0);
        if (cnt > Config::MAX_SAVED_WIFI) cnt = Config::MAX_SAVED_WIFI;
        for (uint32_t i = 0; i < cnt; ++i) {
            char ks[16], kp[16];
            snprintf(ks, sizeof(ks), "w_s%u", static_cast<unsigned>(i));
            snprintf(kp, sizeof(kp), "w_p%u", static_cast<unsigned>(i));
            String s = gPrefs.getString(ks, "");
            String p = gPrefs.getString(kp, "");
            if (s.length() > 0) {
                strncpy(gSavedWifis[gSavedWifiCount].ssid, s.c_str(), sizeof(gSavedWifis[0].ssid) - 1);
                gSavedWifis[gSavedWifiCount].ssid[sizeof(gSavedWifis[0].ssid) - 1] = '\0';
                strncpy(gSavedWifis[gSavedWifiCount].pass, p.c_str(), sizeof(gSavedWifis[0].pass) - 1);
                gSavedWifis[gSavedWifiCount].pass[sizeof(gSavedWifis[0].pass) - 1] = '\0';
                ++gSavedWifiCount;
            }
        }
        String mh = gPrefs.getString("m_host", MQTT_HOST);
        String mu = gPrefs.getString("m_user", MQTT_USER);
        String mp = gPrefs.getString("m_pass", MQTT_PASS);
        String md = gPrefs.getString("m_dev",  MQTT_DEVICE_ID);
        gMqttCfg.port = gPrefs.getUShort("m_port", MQTT_PORT);
        strncpy(gMqttCfg.host, mh.c_str(), sizeof(gMqttCfg.host) - 1); gMqttCfg.host[sizeof(gMqttCfg.host) - 1] = '\0';
        strncpy(gMqttCfg.user, mu.c_str(), sizeof(gMqttCfg.user) - 1); gMqttCfg.user[sizeof(gMqttCfg.user) - 1] = '\0';
        strncpy(gMqttCfg.pass, mp.c_str(), sizeof(gMqttCfg.pass) - 1); gMqttCfg.pass[sizeof(gMqttCfg.pass) - 1] = '\0';
        strncpy(gMqttCfg.dev,  md.c_str(), sizeof(gMqttCfg.dev) - 1);  gMqttCfg.dev[sizeof(gMqttCfg.dev) - 1]   = '\0';
        gPrefs.end();
    }
    // Seed default WiFi from secrets.h if saved list is empty
    if (gSavedWifiCount == 0 && strlen(WIFI_STA_SSID) > 0) {
        addOrUpdateSavedWifi(WIFI_STA_SSID, WIFI_STA_PASSWORD);
    }
    // Fallback MQTT host from secrets.h if NVS host was empty
    if (strlen(gMqttCfg.host) == 0 && strlen(MQTT_HOST) > 0) {
        strncpy(gMqttCfg.host, MQTT_HOST, sizeof(gMqttCfg.host) - 1);
        strncpy(gMqttCfg.user, MQTT_USER, sizeof(gMqttCfg.user) - 1);
        strncpy(gMqttCfg.pass, MQTT_PASS, sizeof(gMqttCfg.pass) - 1);
        gMqttCfg.port = MQTT_PORT;
    }
    if (strlen(gMqttCfg.dev) == 0) strcpy(gMqttCfg.dev, "rig1");
    buildMqttTopics();
}

