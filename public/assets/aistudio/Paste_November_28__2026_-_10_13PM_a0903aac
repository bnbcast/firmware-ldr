static void applyDarkCal(uint16_t raw1, uint16_t raw2) {
    gDark1 = raw1;
    gDark2 = raw2;
    if (gDark1 >= Config::SAT_HIGH_RAW && gBright1 >= 3000) gBright1 = 500;
    if (gDark2 >= Config::SAT_HIGH_RAW && gBright2 >= 3000) gBright2 = 500;
    gBih1 = (gBright1 >= gDark1);
    gBih2 = (gBright2 >= gDark2);
    gCalibrated = true;
    saveCal();
    logf(LogLevel::INFO, "CAL", "Titik GELAP (0%%) disimpan: LDR1=%u(bih=%s) LDR2=%u(bih=%s)",
         gDark1, gBih1 ? "true" : "false", gDark2, gBih2 ? "true" : "false");
}

static void startGuidedTest() {
    gBase1 = gLdr1.raw; gBase2 = gLdr2.raw;
    gPass1 = false; gPass2 = false;
    gGuideIndoorMode1 = (gBase1 >= Config::SAT_HIGH_RAW);
    gGuideState = GuidedState::LDR1_STEP;
    gGuideStartMs = millis();
    if (gGuideIndoorMode1) {
        snprintf(gGuidePrompt, sizeof(gGuidePrompt),
                 "LANGKAH 1/4: Ruangan redup (raw=%u) -> SOROT LDR1 dengan senter HP selama 5 detik!", gBase1);
    } else {
        snprintf(gGuidePrompt, sizeof(gGuidePrompt),
                 "LANGKAH 1/4: TUTUP LDR1 rapat dengan tangan selama 5 detik (awal raw=%u)", gBase1);
    }
    logf(LogLevel::INFO, "GUIDE", "%s", gGuidePrompt);
}

static void updateGuidedTest() {
    if (gGuideState < GuidedState::LDR1_STEP || gGuideState > GuidedState::LDR2_REST) return;
    if ((millis() - gGuideStartMs) < Config::GUIDE_WAIT_MS) return;

    if (gGuideState == GuidedState::LDR1_STEP) {
        gMeas1 = gLdr1.raw;
        int32_t d = static_cast<int32_t>(gBase1) - static_cast<int32_t>(gMeas1);
        gPass1 = (abs(d) >= Config::GUIDE_MIN_DELTA);
        if (gPass1) {
            if (gGuideIndoorMode1) { gDark1 = gBase1; gBright1 = gMeas1; }
            else                   { gBright1 = gBase1; gDark1 = gMeas1; }
            gBih1 = (gBright1 >= gDark1);
        }
        logf(LogLevel::INFO, "GUIDE", "Hasil LDR1: awal=%u akhir=%u delta=%ld -> %s (bih=%s)",
             gBase1, gMeas1, static_cast<long>(d), gPass1 ? "PASS" : "FAIL", gBih1 ? "true" : "false");
        gGuideState = GuidedState::LDR1_REST;
        gGuideStartMs = millis();
        snprintf(gGuidePrompt, sizeof(gGuidePrompt),
                 gGuideIndoorMode1 ? "LANGKAH 2/4: JAUHKAN senter dari LDR1, tunggu 5 detik..."
                                   : "LANGKAH 2/4: BUKA LDR1 sekarang, tunggu 5 detik...");
        logf(LogLevel::INFO, "GUIDE", "%s", gGuidePrompt);
    } else if (gGuideState == GuidedState::LDR1_REST) {
        gBase2 = gLdr2.raw;
        gGuideIndoorMode2 = (gBase2 >= Config::SAT_HIGH_RAW);
        gGuideState = GuidedState::LDR2_STEP;
        gGuideStartMs = millis();
        if (gGuideIndoorMode2) {
            snprintf(gGuidePrompt, sizeof(gGuidePrompt),
                     "LANGKAH 3/4: Ruangan redup (raw=%u) -> SOROT LDR2 dengan senter HP selama 5 detik!", gBase2);
        } else {
            snprintf(gGuidePrompt, sizeof(gGuidePrompt),
                     "LANGKAH 3/4: TUTUP LDR2 rapat dengan tangan selama 5 detik (awal raw=%u)", gBase2);
        }
        logf(LogLevel::INFO, "GUIDE", "%s", gGuidePrompt);
    } else if (gGuideState == GuidedState::LDR2_STEP) {
        gMeas2 = gLdr2.raw;
        int32_t d = static_cast<int32_t>(gBase2) - static_cast<int32_t>(gMeas2);
        gPass2 = (abs(d) >= Config::GUIDE_MIN_DELTA);
        if (gPass2) {
            if (gGuideIndoorMode2) { gDark2 = gBase2; gBright2 = gMeas2; }
            else                   { gBright2 = gBase2; gDark2 = gMeas2; }
            gBih2 = (gBright2 >= gDark2);
        }
        logf(LogLevel::INFO, "GUIDE", "Hasil LDR2: awal=%u akhir=%u delta=%ld -> %s (bih=%s)",
             gBase2, gMeas2, static_cast<long>(d), gPass2 ? "PASS" : "FAIL", gBih2 ? "true" : "false");
        gGuideState = GuidedState::LDR2_REST;
        gGuideStartMs = millis();
        snprintf(gGuidePrompt, sizeof(gGuidePrompt), "LANGKAH 4/4: Selesaikan (tunggu 5 detik)...");
        logf(LogLevel::INFO, "GUIDE", "%s", gGuidePrompt);
    } else if (gGuideState == GuidedState::LDR2_REST) {
        if (gPass1 && gPass2) {
            gCalibrated = true;
            saveCal();
            gGuideState = GuidedState::DONE_PASS;
            snprintf(gGuidePrompt, sizeof(gGuidePrompt),
                     "TES TERPANDU BERHASIL! Polaritas disimpan di NVS (LDR1 bih=%s, LDR2 bih=%s).",
                     gBih1 ? "true" : "false", gBih2 ? "true" : "false");
        } else {
            gGuideState = GuidedState::DONE_FAIL;
            snprintf(gGuidePrompt, sizeof(gGuidePrompt),
                     "TES TERPANDU GAGAL (LDR1=%s, LDR2=%s). Ubah cahaya lebih kontras.",
                     gPass1 ? "PASS" : "FAIL", gPass2 ? "PASS" : "FAIL");
        }
        logf(LogLevel::INFO, "GUIDE", "%s", gGuidePrompt);
    }
}

static bool runSelfTest() {
    scanI2c();
    updateRtc();
    bool ok1 = (gLdr1.health != SensorHealth::CHECK_WIRING);
    bool ok2 = (gLdr2.health != SensorHealth::CHECK_WIRING);
    bool all = gI2cAlive && gRtcPresent && gRtcRunning && gRtcPlausible && ok1 && ok2 && !gBrownoutDetected;
    logf(LogLevel::INFO, "TEST", "=== SELF-TEST: I2C=%s RTC=%s LDR1=%s(%umV) LDR2=%s(%umV) PWR=%s -> %s ===",
         gI2cAlive ? "PASS" : "FAIL",
         (gRtcPresent && gRtcRunning && gRtcPlausible) ? "PASS" : "FAIL",
         ok1 ? "PASS" : "FAIL", gLdr1.mv,
         ok2 ? "PASS" : "FAIL", gLdr2.mv,
         gBrownoutDetected ? "BROWNOUT!" : "OK",
         all ? "PASS" : "FAIL");
    return all;
}

