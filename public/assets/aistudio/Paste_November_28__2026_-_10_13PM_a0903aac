         servoModeToString(gServo.mode), gServo.invert ? "yes" : "no");

    publishStructuredTelemetry();
}

// ============================================================================
// 11. Runtime Diagnostics (3V3 Sag, EMI, Frozen Sensor, Tracking Audit, CrashBox)
// ============================================================================
static void updateFastDiagnostics(uint32_t now) {
    // Update RTC_NOINIT Crash Blackbox continuously
    gCrashBox.magic  = CRASH_BOX_MAGIC;
    gCrashBox.upMs   = now;
    gCrashBox.deg    = static_cast<int16_t>(gServo.currentDeg);
    gCrashBox.target = static_cast<int16_t>(gServo.targetDeg);
    gCrashBox.rssi   = static_cast<int16_t>((WiFi.status() == WL_CONNECTED) ? WiFi.RSSI() : 0);
    gCrashBox.moving = gServo.isMoving() ? 1 : 0;
    strncpy(gCrashBox.lastCmd, gLastCmd, sizeof(gCrashBox.lastCmd) - 1);
    gCrashBox.lastCmd[sizeof(gCrashBox.lastCmd) - 1] = '\0';

    // 1. 3.3V Rail Sag Detector (using top-rail ADC mV when LDR is saturated high)
    uint16_t topMv = 0;
    if (gLdr1.raw >= 4090 && gLdr1.mv > 2500) topMv = gLdr1.mv;
    else if (gLdr2.raw >= 4090 && gLdr2.mv > 2500) topMv = gLdr2.mv;
    if (topMv > 0) {
        if (!gServo.isMoving() && !gServo.pwmActive) {
            if (gRailBaseMv == 0) gRailBaseMv = topMv;
            else gRailBaseMv = static_cast<uint16_t>((static_cast<uint32_t>(gRailBaseMv) * 7 + topMv) / 8);
        } else if (gRailBaseMv > 0) {
            if (gMinRailMv == 0 || topMv < gMinRailMv) gMinRailMv = topMv;
            int16_t sag = static_cast<int16_t>(gRailBaseMv) - static_cast<int16_t>(topMv);
            if (sag > gLastSagMv) gLastSagMv = sag;
            if (sag >= 40 && (now - gLastSagLogMs) >= 5000UL) {
                gLastSagLogMs = now;
                logf(LogLevel::WARN, "PWR", "Rail 3.3V sag -%d mV saat servo gerak! (base=%umV, drop=%umV)",
                     static_cast<int>(sag), gRailBaseMv, topMv);
                char ev[24];
                snprintf(ev, sizeof(ev), "3V3_SAG -%dmV", static_cast<int>(sag));
                eepromAppendEvent(ev);
            }
        }
    }

    // 2. Servo EMI-to-LDR Noise Detector
    float curSd = (gLdr1.sd > gLdr2.sd) ? gLdr1.sd : gLdr2.sd;
    if (!gServo.isMoving() && !gServo.pwmActive) {
        gIdleNoiseEma = (gIdleNoiseEma == 0.0f) ? curSd : (gIdleNoiseEma * 0.9f + curSd * 0.1f);
    } else {
        int16_t diff = static_cast<int16_t>(curSd - gIdleNoiseEma);
        if (diff > gEmiDeltaSd) gEmiDeltaSd = diff;
        if (diff >= 35 && (now - gLastEmiLogMs) >= 8000UL) {
            gLastEmiLogMs = now;
            logf(LogLevel::WARN, "EMI", "Noise LDR melonjak (+%d SD) saat servo gerak (indikasi EMI/ground bounce)",
                 static_cast<int>(diff));
        }
    }
}

static void updateNtpSync() {
    if (gSetupMode || gNtpSynced || WiFi.status() != WL_CONNECTED) return;
    if (!gNtpRequested) {
        gNtpRequested = true;
        configTime(static_cast<long>(gGeoTz * 3600.0f), 0, "pool.ntp.org", "time.google.com");
        return;
    }
    struct tm ti;
    if (getLocalTime(&ti, 5)) {
        uint16_t y = static_cast<uint16_t>(ti.tm_year + 1900);
        uint8_t mo = static_cast<uint8_t>(ti.tm_mon + 1);
        uint8_t d  = static_cast<uint8_t>(ti.tm_mday);
        uint8_t h  = static_cast<uint8_t>(ti.tm_hour);
        uint8_t mi = static_cast<uint8_t>(ti.tm_min);
        uint8_t s  = static_cast<uint8_t>(ti.tm_sec);
        if (isDatePlausible(y, mo, d, h, mi, s)) {
            gNtpSynced = true;
            if (gRtcPresent) {
                int32_t rtcSec = static_cast<int32_t>(gRtcH) * 3600 + static_cast<int32_t>(gRtcMi) * 60 + gRtcS;
                int32_t ntpSec = static_cast<int32_t>(h) * 3600 + static_cast<int32_t>(mi) * 60 + s;
                bool needSync = !gRtcPlausible || !gRtcRunning || (gRtcY != y) || (gRtcMo != mo) || (gRtcD != d) || (abs(rtcSec - ntpSec) > 15);
                if (needSync) {
                    setRtcDateTime(y, mo, d, h, mi, s);
                    logf(LogLevel::INFO, "RTC", "Auto-sinkron NTP (UTC%+.1f) berhasil -> %04u-%02u-%02u %02u:%02u:%02u",
                         gGeoTz, y, mo, d, h, mi, s);
                }
            }
        }
    }
}

static void update1HzDiagnostics() {
    updateNtpSync();
    TrackingDecision dec = evaluateDelta(gLdr1.pct, gLdr2.pct);
    bool bothSat = (gLdr1.health == SensorHealth::SATURATED_HIGH && gLdr2.health == SensorHealth::SATURATED_HIGH) ||
                   (gLdr1.health == SensorHealth::SATURATED_LOW  && gLdr2.health == SensorHealth::SATURATED_LOW);
    if (bothSat) ++gSatSec;
    else if (dec == TrackingDecision::HOLD) ++gHoldSec;
    else ++gTrackSec;

    // Frozen Sensor Detector (only in linear mid-range, if one changes while other stays 100% static > 60s)
    bool l1Mid = (gLdr1.raw > Config::SAT_LOW_RAW && gLdr1.raw < Config::SAT_HIGH_RAW);
    bool l2Mid = (gLdr2.raw > Config::SAT_LOW_RAW && gLdr2.raw < Config::SAT_HIGH_RAW);
    if (l1Mid && gLdr1.raw == gLdr1PrevRaw) ++gLdr1SameSec; else { gLdr1SameSec = 0; gLdr1Frozen = false; }
    if (l2Mid && gLdr2.raw == gLdr2PrevRaw) ++gLdr2SameSec; else { gLdr2SameSec = 0; gLdr2Frozen = false; }
    if (gLdr1SameSec >= 60 && l2Mid && abs(static_cast<int>(gLdr2.raw) - static_cast<int>(gLdr2PrevRaw)) >= 25 && !gLdr1Frozen) {
        gLdr1Frozen = true;
        logf(LogLevel::WARN, "LDR1", "Sensor LDR1 kemungkinan macet/frozen (>60 dtk di raw=%u)", gLdr1.raw);
    }
    if (gLdr2SameSec >= 60 && l1Mid && abs(static_cast<int>(gLdr1.raw) - static_cast<int>(gLdr1PrevRaw)) >= 25 && !gLdr2Frozen) {
        gLdr2Frozen = true;
        logf(LogLevel::WARN, "LDR2", "Sensor LDR2 kemungkinan macet/frozen (>60 dtk di raw=%u)", gLdr2.raw);
    }
    gLdr1PrevRaw = gLdr1.raw;
    gLdr2PrevRaw = gLdr2.raw;
}

// ============================================================================
// 12. setup() & Non-Blocking loop()
// ============================================================================
static uint32_t gLastSampleMs = 0, gLastTrackMs = 0, gLastReportMs = 0, gLast1HzDiagMs = 0;

void setup() {
    Serial.begin(115200);
    uint32_t t0 = millis();
    while (!Serial && (millis() - t0) < 300) {}

    pinMode(Config::PIN_BOOT_BTN, INPUT_PULLUP);
    gResetReason = esp_reset_reason();
    gBrownoutDetected = (gResetReason == ESP_RST_BROWNOUT);

    loadCalAndCounters();
    loadNetConfig();

    Serial.println();
    Serial.println(F("================================================================"));
    Serial.printf("  %s | v%s\n", Config::PROJECT_NAME, Config::FIRMWARE_VERSION);
    Serial.printf("  Boot #%lu | BO=%lu WDT=%lu PANIC=%lu | Reset: %s | Heap: %lu B\n",
                  static_cast<unsigned long>(gBootCount),
                  static_cast<unsigned long>(gBrownoutTotal),
                  static_cast<unsigned long>(gWdtTotal),
                  static_cast<unsigned long>(gPanicTotal),
                  resetReasonToString(gResetReason),
                  static_cast<unsigned long>(ESP.getFreeHeap()));
    Serial.printf("  LDR1=GPIO%u | LDR2=GPIO%u | SERVO=GPIO%u | I2C=SDA%u/SCL%u\n",
                  Config::PIN_LDR1_AO, Config::PIN_LDR2_AO, Config::PIN_SERVO_PWM,
                  Config::PIN_I2C_SDA, Config::PIN_I2C_SCL);
    Serial.println(F("================================================================"));

    Wire.begin(Config::PIN_I2C_SDA, Config::PIN_I2C_SCL, Config::I2C_CLOCK_HZ);
    scanI2c();
    if (gRtcPresent) {
        gRtcDev.begin(&Wire);
        updateRtc();
        if (!gRtcRunning || !gRtcPlausible) {
            logf(LogLevel::WARN, "RTC", "Baterai koin RTC lemah/terlepas! (running=%s, tahun=%u)",
                 gRtcRunning ? "yes" : "no", static_cast<unsigned>(gRtcY));
        }
    }

    // Check RTC_NOINIT Crash Blackbox from previous abnormal reset
    if (gResetReason != ESP_RST_POWERON && gCrashBox.magic == CRASH_BOX_MAGIC) {
        logf(LogLevel::WARN, "BOOT", "Crash Blackbox sebelum reset (%s): up=%lus srv=%d->%d mov=%u rssi=%d cmd='%s'",
             resetReasonToString(gResetReason),
             static_cast<unsigned long>(gCrashBox.upMs / 1000UL),
             static_cast<int>(gCrashBox.deg), static_cast<int>(gCrashBox.target),
             static_cast<unsigned>(gCrashBox.moving), static_cast<int>(gCrashBox.rssi), gCrashBox.lastCmd);
    }

    if (gBrownoutDetected) {
        logf(LogLevel::ERROR, "PWR", "BROWNOUT RESET TERDETEKSI! (Total=%lu) Pastikan power 5V 2A / DC 9-12V.",
             static_cast<unsigned long>(gBrownoutTotal));
        eepromAppendEvent("BROWNOUT_RESET");
    } else if (gResetReason == ESP_RST_INT_WDT || gResetReason == ESP_RST_TASK_WDT || gResetReason == ESP_RST_WDT) {
        eepromAppendEvent("WDT_RESET");
    } else if (gResetReason == ESP_RST_PANIC) {
        eepromAppendEvent("PANIC_RESET");
    }

    gLdr1.begin();
    gLdr2.begin();
    gServo.begin();
    if (gBrownoutDetected) {
        gServo.engageSafeLock();
        logf(LogLevel::WARN, "SRVO", "MG995 SAFE-LOCK aktif pasca BROWNOUT (PWM OFF). Kirim 'servo unlock'/'servo auto' atau tunggu 60 dtk.");
    } else {
        logf(LogLevel::INFO, "SRVO", "MG995 siap (soft-start aktif, arm delay %lus, open-loop GPIO18).",
             static_cast<unsigned long>(Config::SERVO_ARM_DELAY_MS / 1000UL));
    }

    gLdr1.sample(gDark1, gBright1, gBih1);
    gLdr2.sample(gDark2, gBright2, gBih2);

    WiFi.onEvent(onWiFiEvent);
    logf(LogLevel::INFO, "BOOT", "v%s | Boot #%lu | BO=%lu WDT=%lu | Reset=%s | Heap=%lu/%lu B",
         Config::FIRMWARE_VERSION, static_cast<unsigned long>(gBootCount),
         static_cast<unsigned long>(gBrownoutTotal), static_cast<unsigned long>(gWdtTotal),
         resetReasonToString(gResetReason), static_cast<unsigned long>(ESP.getFreeHeap()),
         static_cast<unsigned long>(ESP.getMaxAllocHeap()));

    if (!tryConnectSavedWifis()) {
        startSetupPortal();
    } else {
        gLastNetCheckMs = 0;
        ensureNetworkAndMqtt();
    }

    runSelfTest();

    uint32_t now = millis();
    gServo.armAtMs = now + Config::SERVO_ARM_DELAY_MS;
    gLastSampleMs = now; gLastTrackMs = now; gLastReportMs = now; gLast1HzDiagMs = now;
}

void loop() {
    uint32_t loopStart = millis();
    uint32_t now = loopStart;
    pollSerial();
    pollBootButton();

    if (gServo.safeLock && (now - gServo.lockSinceMs) >= Config::SERVO_LOCK_AUTO_MS) {
        gServo.releaseSafeLock();
        logf(LogLevel::INFO, "SRVO", "MG995 Safe-Lock otomatis terbuka setelah 60 dtk stabil (mode=%s).",
             servoModeToString(gServo.mode));
    }

    if (gSetupMode) {
        gDns.processNextRequest();
        gPortalServer.handleClient();
        if (gPendingExitSetup && static_cast<int32_t>(now - gPendingExitMs) >= 0) {
            stopSetupPortal();
            gLastNetCheckMs = 0;
            ensureNetworkAndMqtt();
        }
    } else {
        ensureNetworkAndMqtt();
        if (gMqtt.connected()) gMqtt.loop();
        gServo.updateSlew();
    }

    if ((now - gLastSampleMs) >= Config::SAMPLE_MS) {
        gLastSampleMs = now;
        gLdr1.sample(gDark1, gBright1, gBih1);
        gLdr2.sample(gDark2, gBright2, gBih2);
        updateGuidedTest();
        updateFastDiagnostics(now);
    }

    if (!gSetupMode && (now - gLastTrackMs) >= Config::SERVO_TRACK_MS) {
        gLastTrackMs = now;
        SunDiag sd = evaluateSunTracking(true);
        updateNightPark(now);
        updateClockAndHybrid(now);
        bool valid = !gNightParked &&
                     (gLdr1.health != SensorHealth::CHECK_WIRING) &&
                     (gLdr2.health != SensorHealth::CHECK_WIRING) &&
                     sd.sunDetected;
        gServo.applyTracking(sd.decision, gLdr1.pct - gLdr2.pct, valid);
    }

    if ((now - gLast1HzDiagMs) >= 1000UL) {
        gLast1HzDiagMs = now;
        update1HzDiagnostics();
    }

    uint32_t repInterval = gServo.isMoving() ? Config::REPORT_MOVING_MS : Config::REPORT_MS;
    if ((now - gLastReportMs) >= repInterval) {
        gLastReportMs = now;
        updateRtc();
        if (gStreamOn) printPeriodicReport();
    }

    uint32_t loopDur = millis() - loopStart;
    if (loopDur > gLoopMaxMs) gLoopMaxMs = loopDur;
    if (loopDur > gLoopPeakMs) gLoopPeakMs = loopDur;
}
