static char gCmdBuf[128];
static size_t gCmdLen = 0;

static void handleSerialCommand(char* line) {
    while (*line == ' ' || *line == '\t') ++line;
    size_t n = strlen(line);
    while (n > 0 && (line[n - 1] == ' ' || line[n - 1] == '\t')) line[--n] = '\0';
    if (n == 0) return;

    strncpy(gLastCmd, line, sizeof(gLastCmd) - 1);
    gLastCmd[sizeof(gLastCmd) - 1] = '\0';

    if (strcmp(line, "help") == 0) {
        Serial.println(F("Perintah: help | scan | rtc | settime YYYY-MM-DD HH:MM:SS | cal guide|dark|bright|reset | servo stop|unlock|auto|manual|center|setcenter|setmin|setmax|min <n>|max <n>|resetlim|trim <n>|resettrim|invert|<deg> | wifi setup|status|reset | mqtt status | selftest | loglevel <lvl>"));
    } else if (strcmp(line, "scan") == 0) {
        scanI2c();
    } else if (strcmp(line, "rtc") == 0) {
        updateRtc();
        logf(LogLevel::INFO, "RTC", "%04u-%02u-%02u %02u:%02u:%02u running=%s plausible=%s",
             gRtcY, gRtcMo, gRtcD, gRtcH, gRtcMi, gRtcS, gRtcRunning ? "yes" : "no", gRtcPlausible ? "yes" : "no");
    } else if (strncmp(line, "settime ", 8) == 0) {
        unsigned y = 0, mo = 0, d = 0, h = 0, mi = 0, s = 0;
        if (sscanf(line + 8, "%u-%u-%u %u:%u:%u", &y, &mo, &d, &h, &mi, &s) == 6) setRtcDateTime(y, mo, d, h, mi, s);
    } else if (strcmp(line, "cal guide") == 0) {
        startGuidedTest();
    } else if (strcmp(line, "cal dark") == 0) {
        applyDarkCal(gLdr1.raw, gLdr2.raw);
    } else if (strcmp(line, "cal bright") == 0) {
        gBright1 = gLdr1.raw; gBright2 = gLdr2.raw;
        gBih1 = (gBright1 >= gDark1); gBih2 = (gBright2 >= gDark2); gCalibrated = true; saveCal();
        logf(LogLevel::INFO, "CAL", "Titik TERANG disimpan: LDR1=%u(bih=%s) LDR2=%u(bih=%s)",
             gBright1, gBih1 ? "true" : "false", gBright2, gBih2 ? "true" : "false");
    } else if (strcmp(line, "cal reset") == 0) {
        gDark1 = Config::DEFAULT_DARK_RAW; gBright1 = Config::DEFAULT_BRIGHT_RAW;
        gDark2 = Config::DEFAULT_DARK_RAW; gBright2 = Config::DEFAULT_BRIGHT_RAW;
        gBih1 = true; gBih2 = true; gCalibrated = false; saveCal();
        logf(LogLevel::INFO, "CAL", "Kalibrasi di-reset ke bawaan");
    } else if (strncmp(line, "servo ", 6) == 0) {
        const char* arg = line + 6;
        if (strcmp(arg, "stop") == 0) {
            gServo.engageSafeLock();
            logf(LogLevel::WARN, "SRVO", "EMERGENCY STOP: PWM OFF & locked di %d deg", gServo.currentDeg);
            return;
        }
        if (strcmp(arg, "unlock") == 0) {
            gServo.releaseSafeLock();
            logf(LogLevel::INFO, "SRVO", "MG995 Safe-Lock dibuka (mode=%s, deg=%d)", servoModeToString(gServo.mode), gServo.currentDeg);
            return;
        }
        if (gServo.safeLock) {
            gServo.releaseSafeLock();
            logf(LogLevel::INFO, "SRVO", "MG995 Safe-Lock otomatis dibuka oleh perintah '%s'", arg);
        }
        if (strcmp(arg, "manual") == 0) { gNightParked = false; gServo.setMode(ServoMode::MANUAL); }
        else if (strcmp(arg, "auto") == 0) { gNightParked = false; gDarkSinceMs = 0; gHybridBiasF = 0.0f; gHybridBiasDeg = 0; gLastTrackDir = 0; gServo.setMode(ServoMode::AUTO); saveCal(); }
        else if (strcmp(arg, "clock") == 0) {
            gNightParked = false; gHybridBiasF = 0.0f; gHybridBiasDeg = 0; gClockRtcWarned = false; gClockForceSync = true;
            gServo.setMode(ServoMode::CLOCK);
            saveCal();
            logf(LogLevel::INFO, "CLK", "Mode CLOCK (NOAA Astro) aktif: El=%.1f Az=%.0f -> target %d deg (step %d deg)",
                 gAstroElevDeg, gAstroAzDeg, gClockDeg, gCosineStepDeg);
        }
        else if (strcmp(arg, "hybrid") == 0) {
            gNightParked = false; gHybridBiasF = 0.0f; gHybridBiasDeg = 0; gClockRtcWarned = false; gClockForceSync = true;
            gServo.setMode(ServoMode::HYBRID);
            saveCal();
            logf(LogLevel::INFO, "CLK", "Mode HYBRID (Astro + PD Log-LDR +-%d deg) aktif: base %d deg",
                 gHybridMaxBias, gClockDeg);
        }
        else if (strcmp(arg, "park") == 0) {
            gNightParked = true;
            if (gParkDeg < gServo.minDeg) gParkDeg = gServo.minDeg;
            if (gParkDeg > gServo.maxDeg) gParkDeg = gServo.maxDeg;
            gServo.setMode(ServoMode::AUTO);
            gServo.setTargetDeg(gParkDeg);
            logf(LogLevel::INFO, "PARK", "Manual Night-Park aktif -> parkir ke %d deg", gParkDeg);
        }
        else if (strcmp(arg, "unpark") == 0) {
            gNightParked = false; gDarkSinceMs = 0; gSunSinceMs = 0;
            logf(LogLevel::INFO, "PARK", "Night-Park dinonaktifkan secara manual");
        }
        else if (strcmp(arg, "setpark") == 0) {
            gParkDeg = gServo.currentDeg;
            saveCal();
            logf(LogLevel::INFO, "PARK", "Posisi parkir malam disimpan: %d deg", gParkDeg);
        }
        else if (strcmp(arg, "center") == 0) { gNightParked = false; gServo.goToCenter(); }
        else if (strcmp(arg, "setcenter") == 0) { gServo.setCenterHere(); saveCal(); }
        else if (strcmp(arg, "setmin") == 0) {
            if (gServo.setMinHere()) { saveCal(); logf(LogLevel::INFO, "SRVO", "Batas MIN diatur ke %d deg (tengah=%d deg)", gServo.minDeg, gServo.centerDeg()); }
            else logf(LogLevel::WARN, "SRVO", "Gagal set MIN: posisi sekarang terlalu dekat dengan MAX (%d deg)", gServo.maxDeg);
        }
        else if (strcmp(arg, "setmax") == 0) {
            if (gServo.setMaxHere()) { saveCal(); logf(LogLevel::INFO, "SRVO", "Batas MAX diatur ke %d deg (tengah=%d deg)", gServo.maxDeg, gServo.centerDeg()); }
            else logf(LogLevel::WARN, "SRVO", "Gagal set MAX: posisi sekarang terlalu dekat dengan MIN (%d deg)", gServo.minDeg);
        }
        else if (strncmp(arg, "min ", 4) == 0) { gServo.setLimits(atoi(arg + 4), gServo.maxDeg); saveCal(); }
        else if (strncmp(arg, "max ", 4) == 0) { gServo.setLimits(gServo.minDeg, atoi(arg + 4)); saveCal(); }
        else if (strcmp(arg, "resetlim") == 0) { gServo.resetLimits(); saveCal(); }
        else if (strcmp(arg, "resettrim") == 0) { gServo.setTrimDeg(0); saveCal(); }
        else if (strncmp(arg, "trim ", 5) == 0) { gServo.setTrimDeg(atoi(arg + 5)); saveCal(); }
        else if (strcmp(arg, "invert") == 0) { gServo.invert = !gServo.invert; saveCal(); }
        else {
            int deg = atoi(arg);
            gNightParked = false;
            gServo.setMode(ServoMode::MANUAL);
            gServo.setTargetDeg(deg);
        }
        logf(LogLevel::INFO, "SRVO", "Mode=%s target=%d deg=%d lim=[%d..%d] ctr=%d trim=%+d phys=%d inv=%s lock=%s",
             servoModeToString(gServo.mode), gServo.targetDeg, gServo.currentDeg,
             gServo.minDeg, gServo.maxDeg, gServo.centerDeg(),
             gServo.trimDeg, gServo.physicalDeg(), gServo.invert ? "yes" : "no", gServo.safeLock ? "yes" : "no");
    } else if (strncmp(line, "clock ", 6) == 0) {
        const char* arg = line + 6;
        unsigned sh = 0, sm = 0, eh = 0, em = 0;
        int bias = gHybridMaxBias;
        int parsed = 0;
        if (sscanf(arg, "%u:%u %u:%u %d", &sh, &sm, &eh, &em, &bias) >= 4) {
            parsed = 1;
        } else if (sscanf(arg, "%u %u %d", &sh, &eh, &bias) >= 2) {
            sm = 0; em = 0; parsed = 1;
        }
        if (parsed && sh <= 23 && sm <= 59 && eh <= 24 && em <= 59) {
            uint16_t sMin = static_cast<uint16_t>(sh * 60U + sm);
            uint16_t eMin = static_cast<uint16_t>(eh * 60U + em);
            if (eMin > 1440) eMin = 1440;
            if (eMin > sMin + 30) {
                gClockStartMin = sMin;
                gClockEndMin   = eMin;
                if (bias < 0) bias = 0;
                if (bias > 45) bias = 45;
                gHybridMaxBias = bias;
                saveCal();
                gClockDeg = computeClockTargetDeg(&gClockDay, &gClockPct);
                logf(LogLevel::INFO, "CLK", "Jadwal RTC disimpan: %02u:%02u-%02u:%02u | Hybrid bias +-%d deg | Target sekarang=%d deg",
                     static_cast<unsigned>(gClockStartMin / 60), static_cast<unsigned>(gClockStartMin % 60),
                     static_cast<unsigned>(gClockEndMin / 60), static_cast<unsigned>(gClockEndMin % 60),
                     gHybridMaxBias, gClockDeg);
            } else {
                logf(LogLevel::WARN, "CLK", "Jam terbenam harus minimal 30 menit lebih besar dari jam terbit.");
            }
        } else {
            logf(LogLevel::WARN, "CLK", "Format salah. Contoh: clock 06:00 18:00 15");
        }
    } else if (strncmp(line, "geo ", 4) == 0) {
        float lat = gGeoLat, lon = gGeoLon, tz = gGeoTz;
        int step = gCosineStepDeg;
        int n = sscanf(line + 4, "%f %f %f %d", &lat, &lon, &tz, &step);
        if (n >= 2 && lat >= -90.0f && lat <= 90.0f && lon >= -180.0f && lon <= 180.0f) {
            gGeoLat = lat;
            gGeoLon = lon;
            if (n >= 3 && tz >= -12.0f && tz <= 14.0f) gGeoTz = tz;
            if (n >= 4) {
                if (step < 1) step = 1;
                if (step > 15) step = 15;
                gCosineStepDeg = step;
            }
            gClockForceSync = true;
            saveCal();
            gClockDeg = computeClockTargetDeg(&gClockDay, &gClockPct);
            logf(LogLevel::INFO, "CLK", "Lokasi Astro disimpan: lat=%.2f lon=%.2f UTC%+.1f | CosStep=%d deg | El=%.1f Az=%.0f -> %d deg",
                 gGeoLat, gGeoLon, gGeoTz, gCosineStepDeg, gAstroElevDeg, gAstroAzDeg, gClockDeg);
        } else {
            logf(LogLevel::WARN, "CLK", "Format salah. Contoh: geo -6.20 106.82 7 4");
        }
    } else if (strcmp(line, "wifi setup") == 0) {
        startSetupPortal();
    } else if (strcmp(line, "wifi status") == 0) {
        logf(LogLevel::INFO, "WIFI", "connected=%s ssid='%s' rssi=%d dBm saved=%u setup=%s",
             WiFi.status() == WL_CONNECTED ? "yes" : "no",
             WiFi.status() == WL_CONNECTED ? WiFi.SSID().c_str() : "",
             WiFi.status() == WL_CONNECTED ? WiFi.RSSI() : 0,
             static_cast<unsigned>(gSavedWifiCount), gSetupMode ? "yes" : "no");
    } else if (strcmp(line, "wifi reset") == 0) {
        gSavedWifiCount = 0;
        saveNetConfig();
        logf(LogLevel::WARN, "WIFI", "Semua Saved WiFi dihapus -> masuk Mode Setup.");
        startSetupPortal();
    } else if (strcmp(line, "mqtt status") == 0) {
        logf(LogLevel::INFO, "MQTT", "connected=%s host=%s:%u dev=%s reconn=%lu fail=%lu rc=%d",
             gMqtt.connected() ? "yes" : "no", gMqttCfg.host, gMqttCfg.port, gMqttCfg.dev,
             static_cast<unsigned long>(gMqttReconnCount), static_cast<unsigned long>(gMqttFailCount), gLastMqttRc);
    } else if (strcmp(line, "blackbox") == 0) {
        eepromDumpEvents();
    } else if (strcmp(line, "blackbox clear") == 0) {
        eepromClearEvents();
    } else if (strncmp(line, "ping ", 5) == 0) {
        logf(LogLevel::INFO, "PONG", "%s", line + 5);
    } else if (strcmp(line, "resetstats") == 0) {
        gLdr1.resetStats(); gLdr2.resetStats();
        logf(LogLevel::INFO, "CMD", "Statistik sensor di-reset");
    } else if (strcmp(line, "selftest") == 0) {
        runSelfTest();
    } else if (strncmp(line, "loglevel ", 9) == 0) {
        const char* lv = line + 9;
        if (strcasecmp(lv, "ERROR") == 0) gLogLevel = LogLevel::ERROR;
        else if (strcasecmp(lv, "WARN") == 0) gLogLevel = LogLevel::WARN;
        else if (strcasecmp(lv, "INFO") == 0) gLogLevel = LogLevel::INFO;
        else if (strcasecmp(lv, "DEBUG") == 0) gLogLevel = LogLevel::DEBUG;
        else if (strcasecmp(lv, "TRACE") == 0) gLogLevel = LogLevel::TRACE;
        logf(LogLevel::INFO, "CMD", "Log level diatur ke %s", levelToString(gLogLevel));
    }
}

static void pollSerial() {
    while (Serial.available() > 0) {
        char c = static_cast<char>(Serial.read());
        if (c == '\r' || c == '\n') {
            if (gCmdLen > 0) { gCmdBuf[gCmdLen] = '\0'; handleSerialCommand(gCmdBuf); gCmdLen = 0; }
        } else if (gCmdLen < sizeof(gCmdBuf) - 1) {
            gCmdBuf[gCmdLen++] = c;
        }
    }
}

static void pollBootButton() {
    bool down = (digitalRead(Config::PIN_BOOT_BTN) == LOW);
    if (down && !gBootBtnWasDown) {
        gBootBtnWasDown = true;
        gBootBtnDownMs = millis();
    } else if (!down && gBootBtnWasDown) {
        gBootBtnWasDown = false;
    } else if (down && gBootBtnWasDown && !gSetupMode) {
        if ((millis() - gBootBtnDownMs) >= Config::BOOT_HOLD_SETUP_MS) {
            gBootBtnWasDown = false;
            logf(LogLevel::INFO, "WIFI", "Tombol BOOT ditahan 3 detik -> membuka Mode Setup WiFi!");
            startSetupPortal();
        }
    }
}

