static void formatRtcStr(char* out, size_t n) {
    if (!gRtcPresent) { snprintf(out, n, "NO-RTC             "); return; }
    snprintf(out, n, "%04u-%02u-%02u %02u:%02u:%02u", gRtcY, gRtcMo, gRtcD, gRtcH, gRtcMi, gRtcS);
}

static bool isPeriodicTag(const char* tag) {
    return (strcmp(tag, "LDR1") == 0 || strcmp(tag, "LDR2") == 0 || strcmp(tag, "DIFF") == 0);
}

static void logf(LogLevel lvl, const char* tag, const char* fmt, ...) {
    if (static_cast<uint8_t>(lvl) > static_cast<uint8_t>(gLogLevel)) return;
    char msg[160];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(msg, sizeof(msg), fmt, ap);
    va_end(ap);

    char rtcStr[24];
    formatRtcStr(rtcStr, sizeof(rtcStr));

    char line[216];
    snprintf(line, sizeof(line), "[%06lu][%s][%s][%-4s] %s",
             static_cast<unsigned long>(millis()), rtcStr, levelToString(lvl), tag, msg);

    Serial.println(line);

    bool important = (lvl <= LogLevel::WARN) || !isPeriodicTag(tag);
    if (important && !gBootLogsFlushed && gBootLogCount < BOOT_LOG_CAP) {
        strncpy(gBootLogs[gBootLogCount], line, sizeof(gBootLogs[0]) - 1);
        gBootLogs[gBootLogCount][sizeof(gBootLogs[0]) - 1] = '\0';
        ++gBootLogCount;
    }

    // Forward all WARN/ERROR and important non-periodic events to MQTT log topic for AI debugging
    if (!gPublishingLog && !gSetupMode && gMqtt.connected() && important) {
        gPublishingLog = true;
        gMqtt.publish(gTopicLog, line, false);
        gPublishingLog = false;
    }
}

