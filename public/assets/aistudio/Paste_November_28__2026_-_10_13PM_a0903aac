// ============================================================================
// 4b. AT24C32 (0x50) Offline Blackbox Logger (32 slots x 32 bytes = 1 KB)
// ============================================================================
constexpr uint16_t BB_MAGIC = 0x5354; // "ST"
constexpr uint16_t BB_SLOTS = 32;
constexpr uint16_t BB_REC_SZ = 32;

static bool eepromWriteBytes(uint16_t memAddr, const uint8_t* data, size_t len) {
    if (!gEepromPresent || len > 32) return false;
    Wire.beginTransmission(Config::I2C_ADDR_AT24C32);
    Wire.write(static_cast<uint8_t>(memAddr >> 8));
    Wire.write(static_cast<uint8_t>(memAddr & 0xFF));
    Wire.write(data, len);
    bool ok = (Wire.endTransmission() == 0);
    delay(6); // AT24C32 internal write cycle (5 ms max)
    return ok;
}

static bool eepromReadBytes(uint16_t memAddr, uint8_t* out, size_t len) {
    if (!gEepromPresent) return false;
    Wire.beginTransmission(Config::I2C_ADDR_AT24C32);
    Wire.write(static_cast<uint8_t>(memAddr >> 8));
    Wire.write(static_cast<uint8_t>(memAddr & 0xFF));
    if (Wire.endTransmission() != 0) return false;
    size_t got = Wire.requestFrom(static_cast<int>(Config::I2C_ADDR_AT24C32), static_cast<int>(len));
    if (got != len) return false;
    for (size_t i = 0; i < len; ++i) out[i] = static_cast<uint8_t>(Wire.read());
    return true;
}

static void eepromAppendEvent(const char* eventText) {
    if (!gEepromPresent || !eventText) return;
    uint8_t hdr[4] = {0};
    uint16_t idx = 0;
    if (eepromReadBytes(0, hdr, 4) && (static_cast<uint16_t>((hdr[0] << 8) | hdr[1]) == BB_MAGIC)) {
        idx = static_cast<uint16_t>((hdr[2] << 8) | hdr[3]);
    }
    uint16_t slot = idx % BB_SLOTS;
    char rec[BB_REC_SZ];
    memset(rec, 0, sizeof(rec));
    snprintf(rec, sizeof(rec), "%02u:%02u %s", gRtcH, gRtcMi, eventText);
    if (eepromWriteBytes(static_cast<uint16_t>(BB_REC_SZ * (slot + 1)), reinterpret_cast<const uint8_t*>(rec), BB_REC_SZ)) {
        ++idx;
        hdr[0] = static_cast<uint8_t>(BB_MAGIC >> 8);
        hdr[1] = static_cast<uint8_t>(BB_MAGIC & 0xFF);
        hdr[2] = static_cast<uint8_t>(idx >> 8);
        hdr[3] = static_cast<uint8_t>(idx & 0xFF);
        eepromWriteBytes(0, hdr, 4);
    }
}

static void eepromDumpEvents() {
    if (!gEepromPresent) { logf(LogLevel::WARN, "EPRM", "AT24C32 (0x50) tidak terdeteksi."); return; }
    uint8_t hdr[4] = {0};
    if (!eepromReadBytes(0, hdr, 4) || (static_cast<uint16_t>((hdr[0] << 8) | hdr[1]) != BB_MAGIC)) {
        logf(LogLevel::INFO, "EPRM", "Blackbox EEPROM masih kosong.");
        return;
    }
    uint16_t total = static_cast<uint16_t>((hdr[2] << 8) | hdr[3]);
    uint16_t count = (total < BB_SLOTS) ? total : BB_SLOTS;
    uint16_t start = (total >= BB_SLOTS) ? (total % BB_SLOTS) : 0;
    logf(LogLevel::INFO, "EPRM", "=== BLACKBOX EEPROM 0x50 (%u/%u event) ===", static_cast<unsigned>(count), static_cast<unsigned>(total));
    for (uint16_t i = 0; i < count; ++i) {
        uint16_t slot = (start + i) % BB_SLOTS;
        char rec[BB_REC_SZ + 1];
        memset(rec, 0, sizeof(rec));
        if (eepromReadBytes(static_cast<uint16_t>(BB_REC_SZ * (slot + 1)), reinterpret_cast<uint8_t*>(rec), BB_REC_SZ)) {
            rec[BB_REC_SZ] = '\0';
            logf(LogLevel::INFO, "EPRM", "#%02u %s", static_cast<unsigned>(i + 1), rec);
        }
    }
}

static void eepromClearEvents() {
    if (!gEepromPresent) return;
    uint8_t hdr[4] = { static_cast<uint8_t>(BB_MAGIC >> 8), static_cast<uint8_t>(BB_MAGIC & 0xFF), 0, 0 };
    eepromWriteBytes(0, hdr, 4);
    logf(LogLevel::INFO, "EPRM", "Blackbox EEPROM 0x50 dikosongkan.");
}

static bool probeI2c(uint8_t addr) {
    Wire.beginTransmission(addr);
    return (Wire.endTransmission() == 0);
}

static void scanI2c() {
    gRtcPresent = false;
    gEepromPresent = false;
    uint8_t count = 0;
    logf(LogLevel::INFO, "I2C", "Memindai bus I2C (SDA=%u, SCL=%u)...", Config::PIN_I2C_SDA, Config::PIN_I2C_SCL);
    for (uint8_t a = 1; a < 127; ++a) {
        if (probeI2c(a)) {
            ++count;
            if (a == Config::I2C_ADDR_DS1307) {
                gRtcPresent = true;
                logf(LogLevel::INFO, "I2C", "Ditemukan 0x%02X (RTC)", a);
            } else if (a == Config::I2C_ADDR_AT24C32) {
                gEepromPresent = true;
                logf(LogLevel::INFO, "I2C", "Ditemukan 0x%02X (AT24C32 EEPROM)", a);
            } else {
                logf(LogLevel::INFO, "I2C", "Ditemukan perangkat di 0x%02X", a);
            }
        }
    }
    gI2cAlive = (count > 0);
}

static void updateRtc() {
    if (!probeI2c(Config::I2C_ADDR_DS1307)) {
        ++gRtcFails;
        if (gRtcFails == 3) {
            logf(LogLevel::WARN, "RTC", "Pembacaan RTC gagal di 0x68. Cek kabel SDA=21/SCL=22.");
        }
        return;
    }
    gRtcPresent = true;
    gI2cAlive = true;
    gRtcRunning = gRtcDev.isrunning();
    DateTime now = gRtcDev.now();
    gRtcY = now.year(); gRtcMo = now.month(); gRtcD = now.day();
    gRtcH = now.hour(); gRtcMi = now.minute(); gRtcS = now.second();
    gRtcPlausible = isDatePlausible(gRtcY, gRtcMo, gRtcD, gRtcH, gRtcMi, gRtcS);
}

static bool setRtcDateTime(uint16_t y, uint8_t mo, uint8_t d, uint8_t h, uint8_t mi, uint8_t s) {
    if (!isDatePlausible(y, mo, d, h, mi, s) || !probeI2c(Config::I2C_ADDR_DS1307)) return false;
    gRtcDev.adjust(DateTime(y, mo, d, h, mi, s));
    updateRtc();
    logf(LogLevel::INFO, "RTC", "Waktu RTC diatur ke %04u-%02u-%02u %02u:%02u:%02u", gRtcY, gRtcMo, gRtcD, gRtcH, gRtcMi, gRtcS);
    return true;
}

