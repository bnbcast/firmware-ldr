class ServoTrackerOutput : public ITrackerOutput {
public:
    ServoMode mode = ServoMode::AUTO;
    int currentDeg = Config::SERVO_HOME_DEG;
    int targetDeg  = Config::SERVO_HOME_DEG;
    int trimDeg    = 0;
    int minDeg     = Config::SERVO_MIN_DEG;
    int maxDeg     = Config::SERVO_MAX_DEG;
    uint32_t lastPulseUs = 1500;
    uint32_t pwmOnMs     = 0;
    uint32_t moveCount   = 0;
    uint16_t dirChgInMin = 0;
    bool huntingSuspected = false;
    bool invert    = false;
    bool pwmActive = false;
    bool atLimit   = false;
    bool wrongDirSuspected = false;
    bool noResponseSuspected = false;
    bool safeLock  = false;       // Engaged after BROWNOUT reset: no PWM until a servo command or 60 s stable
    uint32_t armAtMs = 0;         // No PWM output before this millis() (boot inrush guard)
    uint32_t lockSinceMs = 0;

    int centerDeg() const { return (minDeg + maxDeg) / 2; }

    bool outputAllowed() const {
        return !safeLock && static_cast<int32_t>(millis() - armAtMs) >= 0;
    }

    void engageSafeLock() {
        safeLock = true;
        lockSinceMs = millis();
        mode = ServoMode::MANUAL;
        targetDeg = currentDeg;
        targetUs_ = currentUs_;
        curSpeedUs_ = Config::SERVO_MIN_STEP_US;
        releasePwm();
    }

    void releaseSafeLock() {
        safeLock = false;
        lastMoveMs_ = millis();
    }

    void begin() {
        ledcAttach(Config::PIN_SERVO_PWM, Config::SERVO_PWM_FREQ_HZ, Config::SERVO_PWM_RES_BITS);
        ledcWrite(Config::PIN_SERVO_PWM, 0);
        // Clamp initial position inside saved safe limits (start at center of safe range)
        currentDeg = centerDeg();
        targetDeg  = currentDeg;
        currentUs_ = degToPulseUs(currentDeg);
        targetUs_  = currentUs_;
        lastPulseUs = currentUs_;
        pwmActive = false;
        lastMoveMs_ = millis();
    }

    void releasePwm() {
        ledcWrite(Config::PIN_SERVO_PWM, 0);
        pwmActive = false;
        curSpeedUs_ = Config::SERVO_MIN_STEP_US;
    }

    int physicalDeg() const {
        int p = currentDeg + trimDeg;
        if (p < 5) p = 5;
        if (p > 175) p = 175;
        return p;
    }

    void setLimits(int lo, int hi) {
        if (lo < Config::SERVO_HARD_MIN_DEG) lo = Config::SERVO_HARD_MIN_DEG;
        if (hi > Config::SERVO_HARD_MAX_DEG) hi = Config::SERVO_HARD_MAX_DEG;
        if (lo > hi - 10) {
            lo = Config::SERVO_MIN_DEG;
            hi = Config::SERVO_MAX_DEG;
        }
        minDeg = lo;
        maxDeg = hi;
        if (targetDeg < minDeg) targetDeg = minDeg;
        if (targetDeg > maxDeg) targetDeg = maxDeg;
        targetUs_ = degToPulseUs(targetDeg);
        atLimit = (targetDeg <= minDeg || targetDeg >= maxDeg);
    }

    bool setMinHere() {
        int lo = currentDeg;
        if (lo < Config::SERVO_HARD_MIN_DEG) lo = Config::SERVO_HARD_MIN_DEG;
        if (lo > maxDeg - 10) return false;
        minDeg = lo;
        atLimit = (targetDeg <= minDeg || targetDeg >= maxDeg);
        return true;
    }

    bool setMaxHere() {
        int hi = currentDeg;
        if (hi > Config::SERVO_HARD_MAX_DEG) hi = Config::SERVO_HARD_MAX_DEG;
        if (hi < minDeg + 10) return false;
        maxDeg = hi;
        atLimit = (targetDeg <= minDeg || targetDeg >= maxDeg);
        return true;
    }

    void resetLimits() {
        setLimits(Config::SERVO_MIN_DEG, Config::SERVO_MAX_DEG);
    }

    void goToCenter() {
        setMode(ServoMode::MANUAL);
        setTargetDeg(centerDeg());
    }

    void setCenterHere() {
        int phys = currentDeg + trimDeg;
        int ctr = centerDeg();
        int newTrim = phys - ctr;
        if (newTrim < -Config::SERVO_MAX_TRIM_DEG) newTrim = -Config::SERVO_MAX_TRIM_DEG;
        if (newTrim > Config::SERVO_MAX_TRIM_DEG)  newTrim = Config::SERVO_MAX_TRIM_DEG;
        trimDeg = newTrim;
        currentDeg = ctr;
        targetDeg  = ctr;
        currentUs_ = degToPulseUs(currentDeg);
        targetUs_  = currentUs_;
        atLimit = false;
        writePulseUs(currentUs_);
        lastMoveMs_ = millis();
    }

    void setTrimDeg(int t) {
        if (t < -Config::SERVO_MAX_TRIM_DEG) t = -Config::SERVO_MAX_TRIM_DEG;
        if (t > Config::SERVO_MAX_TRIM_DEG)  t = Config::SERVO_MAX_TRIM_DEG;
        trimDeg = t;
        targetUs_ = degToPulseUs(targetDeg);
        currentUs_ = degToPulseUs(currentDeg);
        writePulseUs(currentUs_);
        lastMoveMs_ = millis();
    }

    void setTargetDeg(int deg) {
        if (deg < minDeg) deg = minDeg;
        if (deg > maxDeg) deg = maxDeg;
        targetDeg = deg;
        targetUs_ = degToPulseUs(targetDeg);
        atLimit = (targetDeg <= minDeg || targetDeg >= maxDeg);
        if (!pwmActive && outputAllowed()) {
            // Re-enable cleanly at current pulse first so the first frame never jumps
            curSpeedUs_ = Config::SERVO_MIN_STEP_US;
            writePulseUs(currentUs_);
        }
        lastMoveMs_ = millis();
    }

    void setMode(ServoMode newMode) {
        mode = newMode;
        wrongDirCount_ = 0;
        wrongDirSuspected = false;
        noRespCycles_ = 0;
        noResponseSuspected = false;
        lastMoveMs_ = millis();
    }

    void applyTracking(TrackingDecision decision, int deltaPercent, bool sensorsValid) override {
        if (safeLock || mode != ServoMode::AUTO || !sensorsValid) return;

        int absDelta = abs(deltaPercent);
        if (decision == TrackingDecision::HOLD) {
            wrongDirCount_ = 0;
            wrongDirSuspected = false;
            noRespCycles_ = 0;
            noResponseSuspected = false;
            prevAbsDelta_ = absDelta;
            return;
        }

        if (movedLastCycle_ && !atLimit) {
            if (absDelta > prevAbsDelta_ + 1) {
                ++wrongDirCount_;
                if (wrongDirCount_ >= 5 && !wrongDirSuspected) {
                    wrongDirSuspected = true;
                    logf(LogLevel::WARN, "SRVO", "Arah servo kemungkinan terbalik! Klik 'Balik Arah' (servo invert).");
                }
            } else if (absDelta < prevAbsDelta_) {
                wrongDirCount_ = 0;
                wrongDirSuspected = false;
            }
            noRespCycles_ = 0;
            noResponseSuspected = false;
        }
        prevAbsDelta_ = absDelta;

        int stepDir = (decision == TrackingDecision::LDR1_BRIGHTER) ? 1 : -1;
        if (invert) stepDir = -stepDir;
        // Proportional step: smooth 1..4 deg per 250 ms cycle (4..16 deg/s tracking)
        int stepSize = (absDelta > 35) ? 4 : ((absDelta > 15) ? 2 : 1);
        int nextTarget = targetDeg + (stepDir * stepSize);
        if (nextTarget < minDeg) nextTarget = minDeg;
        if (nextTarget > maxDeg) nextTarget = maxDeg;

        movedLastCycle_ = (nextTarget != targetDeg);
        if (movedLastCycle_) {
            setTargetDeg(nextTarget);
        } else {
            atLimit = (targetDeg <= minDeg || targetDeg >= maxDeg);
        }
    }

    void updateSlew() {
        uint32_t now = millis();
        if (!outputAllowed()) {
            lastPwmTickMs_ = 0;
            return;
        }
        if (pwmActive) {
            if (lastPwmTickMs_ > 0) pwmOnMs += (now - lastPwmTickMs_);
            lastPwmTickMs_ = now;
        } else {
            lastPwmTickMs_ = 0;
        }
        // Reset hunting counter every 60 s
        if ((now - dirWinStartMs_) >= 60000UL) {
            dirWinStartMs_ = now;
            dirChgInMin = 0;
            huntingSuspected = false;
        }

        int32_t diffUs = static_cast<int32_t>(targetUs_) - static_cast<int32_t>(currentUs_);
        if (diffUs != 0) {
            if ((now - lastFrameMs_) >= Config::SERVO_FRAME_MS) {
                lastFrameMs_ = now;
                int8_t dir = (diffUs > 0) ? 1 : -1;
                if (lastMoveDir_ != 0 && dir != lastMoveDir_) {
                    ++dirChgInMin;
                    curSpeedUs_ = Config::SERVO_MIN_STEP_US;
                    if (dirChgInMin >= 6 && !huntingSuspected) {
                        huntingSuspected = true;
                        logf(LogLevel::WARN, "SRVO", "Servo hunting terdeteksi (%u balik arah/menit)!", static_cast<unsigned>(dirChgInMin));
                    }
                }
                lastMoveDir_ = dir;

                // Smooth trapezoid/S-curve velocity ramp in microseconds per 20 ms frame:
                // Gently accelerates from 2 us/frame -> 6 us/frame, and eases down within 40 us of target.
                int32_t rem = abs(diffUs);
                int desiredSpeed = (rem < 40) ? max(Config::SERVO_MIN_STEP_US, static_cast<int>(rem / 7)) : Config::SERVO_MAX_STEP_US;
                if (curSpeedUs_ < desiredSpeed) ++curSpeedUs_;
                else if (curSpeedUs_ > desiredSpeed) --curSpeedUs_;
                if (curSpeedUs_ < Config::SERVO_MIN_STEP_US) curSpeedUs_ = Config::SERVO_MIN_STEP_US;

                int32_t step = (rem < curSpeedUs_) ? rem : curSpeedUs_;
                currentUs_ = static_cast<uint32_t>(static_cast<int32_t>(currentUs_) + dir * step);
                int newDeg = pulseUsToDeg(currentUs_);
                if (newDeg != currentDeg) {
                    currentDeg = newDeg;
                    ++moveCount;
                }
                writePulseUs(currentUs_);
                lastMoveMs_ = now;
            }
        } else {
            curSpeedUs_ = Config::SERVO_MIN_STEP_US;
            if (currentDeg != targetDeg) currentDeg = targetDeg;
            if (pwmActive && (now - lastMoveMs_) >= Config::SERVO_IDLE_OFF_MS) {
                releasePwm();
            }
        }
    }

    bool isMoving() const { return currentUs_ != targetUs_; }
    bool inSoftStart() const { return isMoving() && curSpeedUs_ < Config::SERVO_MAX_STEP_US; }

private:
    uint32_t degToPulseUs(int logicalDeg) const {
        int physDeg = logicalDeg + trimDeg;
        if (physDeg < 5) physDeg = 5;
        if (physDeg > 175) physDeg = 175;
        return Config::SERVO_MIN_PULSE_US +
            (static_cast<uint32_t>(physDeg) * (Config::SERVO_MAX_PULSE_US - Config::SERVO_MIN_PULSE_US)) / 180UL;
    }

    int pulseUsToDeg(uint32_t us) const {
        if (us <= Config::SERVO_MIN_PULSE_US) return minDeg;
        uint32_t phys = ((us - Config::SERVO_MIN_PULSE_US) * 180UL + 1000UL) /
                        (Config::SERVO_MAX_PULSE_US - Config::SERVO_MIN_PULSE_US);
        int deg = static_cast<int>(phys) - trimDeg;
        if (deg < minDeg) deg = minDeg;
        if (deg > maxDeg) deg = maxDeg;
        return deg;
    }

    void writePulseUs(uint32_t pulseUs) {
        lastPulseUs = pulseUs;
        if (!outputAllowed()) return;
        uint32_t duty = (pulseUs * 65535UL) / 20000UL;
        ledcWrite(Config::PIN_SERVO_PWM, duty);
        pwmActive = true;
    }

    uint32_t currentUs_ = 1500;
    uint32_t targetUs_  = 1500;
    int curSpeedUs_ = Config::SERVO_MIN_STEP_US;
    uint32_t lastFrameMs_ = 0;
    uint32_t lastMoveMs_ = 0;
    uint32_t lastPwmTickMs_ = 0;
    uint32_t dirWinStartMs_ = 0;
    int8_t lastMoveDir_ = 0;
    int prevAbsDelta_ = 0;
    uint8_t wrongDirCount_ = 0;
    uint8_t noRespCycles_ = 0;
    bool movedLastCycle_ = false;
};

